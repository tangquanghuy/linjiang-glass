---
# ============================================================
# 管人痴 / 都市日系SLG · MVU 变量定义与更新规则
#
# 冷代码换算（时段、日期显示、私密度、牌子等级、换日扣天数）
# 写在 变量相关/辅助计算脚本.js，挂酒馆「脚本」单独跑。
# 不要塞进玻璃状态栏。
# ============================================================

世界信息:
  年历:
    format: "{YYYY}年{MM}月{DD}日"
    check:
      - 每天跨越深夜(04:00)或睡眠时 年历 +1 天
      - 星期、季节、年内第几周不写入本字段。由 变量相关/辅助计算脚本.js 按预置年历表算出后写入 日期显示，供 HUD 读取。不要把这套换算塞进状态栏 iframe（加载顺序盖不住整段对话）
      - 季节按公历气象季：3–5 春、6–8 夏、9–11 秋、12–2 冬。年内第几周从该年 1 月 1 日起每 7 天一周（1–7 日为第 1 周）。表预置 2026–2030，缺档用同一公式
  日期显示:
    path: /世界信息/日期显示
    type: |-
      {
        星期: '周日' | '周一' | '周二' | '周三' | '周四' | '周五' | '周六';
        季节: '春季' | '夏季' | '秋季' | '冬季';
        年内周次: number;
      }
    check:
      - 外部脚本按 年历 写入，AI 禁止写。不是时间真源，只给 HUD 显示
      - 真源仍是 年历。换日只改 年历，副信息由脚本跟上
  时间:
    时钟:
      format: "HH:mm"
      path: /世界信息/时间/时钟
      type: string
      check:
        - 当前钟点，是时间的真源。AI 随行动、等待、换场所推进时钟；跨过 04:00 或睡眠时同时 +1 年历
    时段:
      type: '"朝" | "昼" | "暮" | "夜" | "深夜"'
      path: /世界信息/时间/时段
      check:
        - 由 变量相关/辅助计算脚本.js 按时钟换算，AI 禁止写一个和时钟不符的时段
        - 朝: 06:00 - 09:00 (早起/准备)
        - 昼: 09:00 - 16:00 (外出/打工/常规活动)
        - 暮: 16:00 - 19:00 (傍晚/放学/下班/采摘约会)
        - 夜: 19:00 - 23:00 (夜生活/直播/居酒屋/密会)
        - 深夜: 23:00 - 06:00 (睡眠/深夜潜入/私密互动)
  位置:
    path: /世界信息/位置/
    区域:
      format: "{大区域名}·{子区域名}"
      check:
        - 子区域名只用完整地名，不加修饰词
        - 大区域为行政区或风景区（如 鼓岭区、明湖区、乌溪区、青屏山风景区）
        - 子区域为地图节点名（如 梧桐里、青屏山密林、云庭公寓、自宅）
        - 例如 鼓岭区 · 梧桐里；青屏山风景区 · 青屏山密林
        - 跨区移动或进入新节点时更新
    场所:
      check:
        - 进入新房间或具体小地点时更新，仅能写入无独立背景设定的小地点
        - 例如试衣间、公厕隔间、歇脚长椅、观景崖边、日料包厢、自宅卧室
        - 禁止将大小区域更新此处，例如行政区、风景区、整栋商场、整座山林都属于区域
    私密度:
      type: number # 0 ~ 5
      check:
        - 0: 闹市人潮（商场大厅/地铁车厢）
        - 1: 开放公共（步行街/餐厅大厅）
        - 2: 独立包厢/微隐蔽（咖啡厅角落/日料包厢）
        - 3: 视线遮蔽（大棚深处/试衣间/电影院后排）
        - 4: 偏僻野外（密林深处/露营区无人角落/天台）
        - 5: 绝对密闭私密（自宅卧室/情侣酒店/反锁更衣室）
        - 仍有价值：当场能不能做露出、隐奸、当众，不能只靠区域名字猜
        - 必须跟地点走。移动后由 变量相关/辅助计算脚本.js 按地图节点/场所表改写；AI 禁止单独改一个和地点不符的数
        - 这是玩家所在格的私密度。对象另有自己的 位置.私密度，人可能不在同一处

  # ------------------------------------------------------------
  # 动态事件池：AI 自主管理与每日刷新
  # ------------------------------------------------------------
  事件池:
    当日事件:
      path: /世界信息/事件池/当日事件
      type: |-
        {
          [事件ID: string]: {
            区域: string;              // 触发区域，格式 大区域名·子区域名
            场所?: string;             // 可选，更具体的小地点
            标题: string;              // 事件标题
            分类: Array<'纯爱' | '日常' | '生理窘迫' | '调教' | '睡奸' | '催眠奸' | '特殊H'>;
                                       // 各分支分类并集，供筛选；玩家选定后本轮只走那条
            优先级: number;            // 优先级 1~100 (数值越大越优先)
            状态: '待触发' | '可触发' | '已完成' | '已过期';
            条件: {
              好感度?: number;         // 好感度门槛 (0~1000)
              顺从度?: number;         // 顺从度门槛 (0~1000)
              性欲度?: number;         // 性欲度门槛 (0~100)
              体力上限?: number;       // 体力上限门槛 (如 <=20 触发睡奸)
              需携带道具?: string;     // 需携带道具
              时段?: string[];         // 触发时段限制
            };
            简述: string;              // 事件简述与悬念
          }
        }
      check:
        - 每日换日刷新时，AI 自主保留未过期的常驻事件，清理过期事件，并根据当前角色关系生成 2~3 条当日新事件
        - 必须保证各区域具有合理的梯度分布（低好感日常 / 中好感暧昧 / 高好感高顺从调教或特殊H / 低体力睡奸 / 暗示中的催眠奸）
        - 分类是各 card 分支分类的并集，不要写在事件根上当成整场只有一种味道
        - 同一舞台必须拉开分支：纯爱看日落就不能再配一条整理发夹；mischief 必须是真调教/恶作剧
        - 不要按 12 轴性经历来贴分类：露出/自慰/盗摄是结算结果，通常落在调教分支上
        - 催眠奸：人醒着、已有暗示/洗脑，与睡奸分开；只发情或微醺不算
        - 特殊H：隐奸、青奸、性直播；扮演/凌辱走调教分支
        - 当玩家移动到指定区域（及场所）且满足条件时，将状态标记为 '可触发'，并在正文中驱动该事件发生，输出 <突发事件> 交互卡片

玩家信息:
  体力:
    path: /玩家信息/体力
    type: number # 0 ~ 100
    check:
      - 每次移动、探索、采集、打工消耗 10~30 点
      - 进食、休息或睡眠时恢复，上限 100
  金钱:
    path: /玩家信息/金钱
    type: number
    check:
      - 临时工、剧情奖励、交通、购买道具、就餐、门票等由 AI 按正文结算
      - 正式班工资按 工作.日收入 发放，见工作条；AI 禁止在已入职的正式班另写一笔工钱
      - 直播打赏、办卡扣款由外部脚本从本字段扣除，AI 禁止因打赏或办卡改金钱
  同行:
    path: /玩家信息/同行
    type: "string | null"
    check:
      - 当前同行对象的名称，独行时为 null

  # ------------------------------------------------------------
  # 工作：入职时写合同，上一天班按日收入发薪
  # ------------------------------------------------------------
  工作:
    path: /玩家信息/工作
    type: |-
      {
        职业: string | null;     // 无业为 null，如 '便利店店员'、'西洲MCN运营'
        地点: string | null;     // 大区域名·子区域名，与 世界信息.位置.区域 同格式；无业为 null
        日收入: number;          // 每上一天班发放的工资金额；无业必须为 0。HUD 资金旁的 +N 读这个
        今日已上班: boolean;     // 当日这份正式班是否已经上过（上过即已按日收入发薪）
      }
    check:
      - 入职、换工作、辞职时由 AI 一并改 职业、地点、日收入（日收入按这份工作合理定价，不要每天重开价）。无业时三字段为 null / null / 0
      - 地点格式与 世界信息.位置.区域 相同，必须是地图上的节点名，禁止写「公司」「店里」这类泛称
      - 点地图只更新 位置，只开放移动，不发薪、不触发上班
      - 正式班发薪前提：位置.区域 == 工作.地点（已经到岗）。人在别处不能领这份工钱
      - 发薪两条入口，金额只读 日收入，禁止另发明金：
        * HUD 点上班：外部脚本 金钱+=日收入、今日已上班=true，并可扣体力
        * 聊天里说去上班：AI 按 日收入 加钱并置 今日已上班=true。脚本看不见聊天；正文应先到岗再干活
      - 今日已上班=true 则当日这份正式班不再发。换日由外部脚本把 今日已上班 置回 false
      - 无业或 日收入=0 不能走正式班发薪；路边临时工、一次性报酬仍由 AI 改金钱
      - 禁止用好感、打赏、牌子档位改日收入

  # ------------------------------------------------------------
  # 居住：家在哪睡觉。位置.区域 是人现在在哪，本字段是床在哪
  # ------------------------------------------------------------
  居住地:
    path: /玩家信息/居住地
    type: string
    check:
      - 格式 大区域名·子区域名，与 世界信息.位置.区域 相同。示例：鼓岭区 · 云庭公寓
      - 睡觉、过夜、回居所休息时，把 位置.区域 更新到这里（场所可写卧室等无独立背景的小地点）
      - 必须指向 房产 里某一处的 区域；搬家只改本字段，不要另造地名
  房产:
    path: /玩家信息/房产
    type: |-
      {
        [名称: string]: {
          名称: string;                           // 如 '云庭公寓'
          区域: string;                           // 大区域名·子区域名
          产权: '租住' | '自有' | '借住';
          描述: string;                           // 一句话：几居、和谁合租、能不能把人带回来
        }
      }
    check:
      - 至少一处，作为默认的家。租到、买到、被赶走、退租时由 AI 增删改；若以后面板成交房产，外部脚本也可写
      - 居住地 从房产里选一处现住。面板点「设为住所」时由外部脚本改 居住地；聊天里说搬家由 AI 改
      - 产权只取 租住/自有/借住。房租倒计时本次不单开，到期退租由正文或后续脚本补
      - 禁止把整座行政区、商场、山林写成房产

  所在直播间:
    path: /玩家信息/所在直播间
    type: "string | null"
    check:
      - 当前正在观看的直播间对象名；未在任何房间时为 null
      - 两条入口，外部脚本监控不到聊天，不能包办本字段：
        * 从 HUD 面板点进/退出某直播间：由外部脚本写入（面板能确定进的是谁）
        * 玩家在正文/聊天里说去看谁、退出房间：由 AI 写入。脚本看不见聊天，禁止等脚本来改
      - 禁止在玩家未明示（面板或正文）时，把人塞进某个房间
      - 与同行互不排斥：可以一边与 A 同行，一边看 B 的直播
      - 该对象下播时：正文写下播则 AI 把本字段置 null；若开播是脚本按时段关掉的，脚本可辅助清掉仍停在该房间的指针
      - 打赏前提：对象.直播.开播==true 且 所在直播间==该对象名。面板打赏缺一则外部脚本拒绝扣款；聊天里口头刷礼物不走扣款，见金钱条

  # ------------------------------------------------------------
  # 粉丝身份：按对象名分账。倒计时/累计/换算一律外部脚本，AI 只读结果
  # ------------------------------------------------------------
  粉丝身份:
    path: /玩家信息/粉丝身份
    type: |-
      {
        [对象名: string]: {
          关注: boolean;             // 是否关注该主播
          累计打赏: number;          // 该房间累计打赏+办卡花费（￥），不含私下送礼
          牌子等级: number;          // 0=无牌子，1~20；脚本按幂函数算，满级累计￥200000
          牌子档位: '无' | '办卡' | '舰长' | '提督' | '总督';  // 只记当前最高的一档
          牌子剩余天数: number;      // 0~30，档位为「无」时必须为 0
          房管: boolean;             // 是否为该房间房管
          禁言中: boolean;           // AI 判断「当下能不能发弹幕」只看这个
          禁言剩余天数: number;      // 0=不限期（等 AI 解禁）；>0 则换日扣减
        }
      }
    check:
      - 没有该对象的键，视为路人：未关注、累计 0、牌子等级 0、牌子档位「无」、非房管、未禁言。禁止为路人补空对象
      - 累计打赏、牌子等级、牌子档位、牌子剩余天数由外部脚本更新，AI 只读，禁止手改（金额和倒计时不靠聊天认）
      - 关注：两条入口，同所在直播间。状态栏直播间入口或 HUD 点关注/取关由外部脚本改布尔；玩家在聊天里说关注或取关由 AI 写。禁止因好感高低替玩家关注或取关
      - 开播提醒不另开 MVU 字段。外部脚本在「已关注且开播从未开播变为开播」时推送通知；状态栏红点由 HUD 按「已关注且当前开播」计数显示，点进直播间入口即可看到是谁
      - 累计打赏：每次直播打赏、办卡成功后，外部脚本把实付金额加进来；免费礼物 +0；私下送礼不计入
      - 牌子等级：由 变量相关/辅助计算脚本.js 计算，AI 只读现成数字，禁止自算。累计<=0 为 0；累计>=200000 为 20；否则 min(20, floor(20 * (累计打赏/200000)^(1/3.5)))。1 级大约几块钱，越往后越陡，15 级之后明显变难，满级累计 ￥200000。公式结果每次写回；档位到期不降等级
      - 牌子档位：无 < 办卡 < 舰长 < 提督 < 总督。只留当前最高的一档，禁止并列存两档。新档必须严格高于现档才改写；同档续费只重置天数；低于现档的购买直接忽略
      - AI 判断「有没有办卡」只看 牌子档位!==「无」；需要区分待遇时再读档位本身。禁止用档位换好感或顺从，待遇见世界书<真实直播规则>
      - 牌子剩余天数：由外部脚本负责更新。办卡/舰长/提督/总督成功写 30；换日 -1；归零时脚本把 牌子档位改回「无」。续费重置为 30 不叠加
      - 房管：剧情任命或撤职时由 AI 写布尔。禁止因打赏金额或档位自动升房管
      - 禁言中：剧情里被禁/解禁时由 AI 写布尔。AI 只看这个决定能不能发弹幕，不要心算剩余天数
      - 禁言剩余天数：由外部脚本负责更新。AI 置 禁言中=true 时不要写天数（0=不限期，等 AI 置 false）。需要有限期禁言时由外部脚本写入天数，换日 -1，归零时脚本把 禁言中=false
      - 累计打赏、牌子等级、牌子档位与好感度/顺从度禁止互推：刷钱不是喜欢她，总督不是恋人

  # ------------------------------------------------------------
  # 背包与道具系统（素材 / 消耗品 / 用品）
  # ------------------------------------------------------------
  背包:
    素材:
      path: /玩家信息/背包/素材
      type: |-
        {
          [素材名: string]: {
            名称: string;        // 名称，如 '蓝色野生花瓣'
            类别: '植物' | '动物' | '矿物' | '化学' | '织物' | '其他';
            数量: number;        // 数量
            来源: string;        // 获取途径，如 '青屏山采集'
            描述: string;        // 药性/用途描述
          }
        }
      check:
        - 在野外/农园执行「采集」行动时获得
        - 在自宅/工坊执行「调配/合成」时扣除数量，数量 <= 0 时删除对应键
        - 类别是闭合枚举，只能取上列六个值之一，禁止自造新类别；判定不出时写 '其他'
        - 类别按加工形态归类，不按来源：未加工的动物原材（羽毛/鳞/贝壳/蜂蜜/兽毛生料）算动物，加工成布/皮/线之后算织物；提纯过的花精算化学，整片花瓣算植物
    消耗品:
      path: /玩家信息/背包/消耗品
      type: |-
        {
          [道具名: string]: {
            名称: string;        // 名称，如 '便当', '矿泉水', '润滑剂', '催情药'
            类别: '食物' | '饮料' | '药物' | '日用' | '其他';
            数量: number;        // 数量
            强度: number;        // 作用强弱 1~5，食品/药品/日用品通用
            描述: string;        // 是什么、怎么用、用了会怎样，写在一处
          }
        }
      check:
        - 通过商店购买、合成、任务或剧情获得；不限定为药品
        - 使用或丢弃时 数量 -1，数量 <= 0 时移除
        - 描述与效果不必分开：描述里写清外观、用途和用后结果即可，结算时按描述判定作用方向，按强度判定幅度
        - 强度 1 微弱 / 3 常规 / 5 极强；便当回体力、药改生理、日用品提供便利都用这个值，禁止当成专用药效字段
        - 类别是闭合枚举，只能取上列五个值之一，禁止自造新类别；判定不出时写 '其他'
        - 类别判定：能喝的算饮料，改变生理状态的算药物，只提供便利的算日用（润滑剂/湿巾/避孕用品都是日用，不是药物）
    用品:
      path: /玩家信息/背包/用品
      type: |-
        {
          [用品名: string]: {
            名称: string;        // 名称，如 '项圈与牵引绳', '护士服与白丝', '无线遥控跳蛋'
            类别: '服装' | '饰品' | '器具' | '器材' | '其他';
            数量: number;        // 通常为 1，同名可叠加
            佩戴: boolean;       // 当前是否穿在/戴在同行对象身上
            描述: string;        // 外观，以及能开什么玩法
          }
        }
      check:
        - 项圈、跳蛋、眼罩、情趣服装等耐用品写这里，禁止塞进消耗品
        - 商店购买、剧情获得或从对象身上收缴时 add；使用不扣数量，丢弃或送出才 remove
        - 穿上/戴上/放入体内时 佩戴=true，脱下或收回时=false；同时佩戴的服装以剧情合理为限
