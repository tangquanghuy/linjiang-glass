<变量更新规则>
变量更新规则:

  _复用:
    年历格式: &FMT "{YYYY}年{MM}月{DD}日"
    区域格式: &AREA "{大区域名} · {子区域名}"
    时段: &E_period 朝|昼|暮|夜|深夜
    事件分类: &E_event_cat 纯爱|日常|生理窘迫|调教|睡奸|催眠奸|特殊H
    事件状态: &E_event_status 待触发|可触发|已完成|已过期
    产权: &E_tenure 租住|自有|借住
    牌子档位: &E_fan_tier 无|办卡|舰长|提督|总督
    素材类别: &E_mat 植物|动物|矿物|化学|织物|其他
    消耗品类别: &E_cons 食物|饮料|药物|日用|其他
    用品类别: &E_goods 服装|饰品|器具|器材|其他
    对象名: &E_girl 东雪莲|塔菲|沙花叉|时雨羽衣|红蔷薇|斯黛拉|璃亚梦

  全局:
    基准: [以结构定义为准]
    对象闭合: [仅*E_girl；禁增删改名；全名须改短名(永雏塔菲→塔菲/沙花叉克萝伊→沙花叉/梦见璃亚梦→璃亚梦/伊贺栖寅→斯黛拉)]
    脚本只读: [日期显示, 时段, 私密度, 累计打赏, 牌子等级, 牌子档位, 牌子剩余天数, 禁言剩余天数, 直播.人数]
    双入口: [所在直播间/关注/上班：HUD点的由脚本写，正文说的由AI写，禁等脚本、禁替玩家决定]
    通用: [add=全字段非空对象; 更新用replace/delta; 超range截断; 数字增减用delta]

  结构定义:
    当日事件: &S_event "{[事件ID]:{区域;场所?;标题;分类:*E_event_cat[];优先级:num;状态:*E_event_status;条件:{好感度?:num;顺从度?:num;性欲度?:num;体力上限?:num;需携带道具?;时段?:*E_period[]};简述}}"
    工作: &S_job "{职业:str|null;地点:str|null;日收入:num;今日已上班:bool}"
    房产项: &S_house "{名称;区域;产权:*E_tenure;描述}"
    粉丝身份: &S_fan "{关注:bool;累计打赏:num;牌子等级:num;牌子档位:*E_fan_tier;牌子剩余天数:num;房管:bool;禁言中:bool;禁言剩余天数:num}"
    素材: &S_mat "{名称;类别:*E_mat;数量:num;来源;描述}"
    消耗品: &S_cons "{名称;类别:*E_cons;数量:num;强度:num;描述}"
    用品: &S_goods "{名称;类别:*E_goods;数量:num;佩戴:bool;描述}"
    羁绊: &S_bond "{好感度:num;顺从度:num;心情:str}"
    位置: &S_loc "{区域;场所;私密度:num}"
    性经历: &S_exp "{近期性经验次数:num;露出经验:num;自慰经验:num;排泄调教经验:num;道具调教经验:num;凌辱调教经验:num;隐奸经验:num;青奸经验:num;睡奸经验:num;催眠奸经验:num;情趣扮演经验:num;盗摄经验:num;性直播经验:num}"
    开发部位: &S_dev_part "{档位:num;评语:str}"
    开发度: &S_dev "{口腔:*S_dev_part;胸:*S_dev_part;小穴:*S_dev_part;肛门:*S_dev_part}"
    生理: &S_phys "{性欲度:num;体力:num;尿意:num;异常状态:str[]}"
    直播: &S_stream "{开播:bool;标题;人数:num}"

  世界信息:
    年历:
      format: *FMT
      check: [跨04:00或睡眠时+1天; 禁写星期/季节/周次]
    日期显示:
      readonly: true
    时间:
      时钟:
        format: "HH:mm"
        check: [时间真源，随行动推进；跨04:00或睡眠同时年历+1]
      时段:
        readonly: true
    位置:
      type: *S_loc
      区域:
        format: *AREA
        check: [子区域用完整地名无修饰; 大区域=行政区/风景区, 子区域=地图节点; 跨节点更新]
      场所:
        check: [只写无独立背景的小地点(试衣间/包厢/卧室); 禁写行政区/商场/山林]
      私密度:
        readonly: true
    事件池:
      当日事件:
        type: *S_event
        check:
          - 换日留常驻清过期，按关系补2~3条; 分类=分支并集，同舞台须拉开
          - 催眠奸≠睡奸(须醒着有暗示); 特殊H=隐奸/青奸/性直播; 扮演凌辱走调教; 露出自慰盗摄是结算通常算调教
          - 到点且条件满足→状态=可触发，正文驱动并出<突发事件>

  玩家信息:
    体力:
      range: 0~100
      check: [移动探索采集打工-10~30; 进食休息睡眠恢复]
    金钱:
      range: 0~
      check: [临时工/购物/交通/门票由AI结算; 正式班只走日收入; 打赏办卡禁改金钱]
    同行:
      type: "*E_girl | null"
      check: [独行=null; 只用短名]
    工作:
      type: *S_job
      check:
        - 入职/离职一并改职业地点日收入; 无业=null/null/0; 地点=*AREA禁写「公司」
        - 正式班须到岗(位置.区域==工作.地点)才发薪，金额=日收入不另发明金; 正文上班AI加钱并置今日已上班=true; 当日不重发
        - 临时工仍改金钱; 禁用好感/打赏/档位改日收入
    居住地:
      format: *AREA
      check: [床在哪; 过夜时把位置.区域改到这里; 必须是某房产.区域]
    房产:
      type: "{[名称]:*S_house}"
      check: [至少1处; 租买退租时增删; 禁把行政区/商场/山林写成房产]
    所在直播间:
      type: "*E_girl | null"
      check: [未观看=null; 禁未明示塞进房间; 可与同行并存; 正文下播置null]
    粉丝身份:
      type: "{[对象名]:*S_fan}"
      check:
        - 无键=路人，禁补空; 首次关注/房管/禁言才add(脚本字段填0/无/false)
        - AI只写关注(正文)/房管/禁言中; 置禁言中勿写天数; 禁用牌子推好感顺从
    背包:
      素材:
        type: "{[名]:*S_mat}"
        check: [采集+/合成-，≤0 remove; 类别*E_mat判定不出=其他; 原材动物/成布织物/花精化学/花瓣植物]
      消耗品:
        type: "{[名]:*S_cons}"
        check: [获得+/使用-，≤0 remove; 强度1~5写在描述里; 能喝=饮料, 改生理=药物, 便利=日用]
      用品:
        type: "{[名]:*S_goods}"
        check: [耐用品禁进消耗品; 使用不扣量，丢弃送出才remove; 穿戴佩戴true/false; 衣=服装, 装饰=饰品, 用在她身上=器具, 自己手里=器材; 器材恒佩戴=false]

  对象信息:
    type: "{[对象名]:{羁绊:*S_bond;位置:*S_loc;性经历:*S_exp;开发度:*S_dev;生理:*S_phys;直播:*S_stream}}"
    "{对象名}":
      羁绊:
        type: *S_bond
        好感度:
          range: 0~1000
          check: [约会温柔礼物+5~20; 粗暴违背-10~50; 禁打赏档位加减]
        顺从度:
          range: 0~1000
          check: [成功羞耻命令+10~30; 一味溺爱微降或不变; 350轻度服从/600野外当面小便]
        心情:
          type: str
          check: [随当轮情绪replace，短词或短语]
      位置:
        type: *S_loc
        check: [她在哪，禁改成玩家位置; 区域场所规则同世界信息; 同行时区域必须相同; 开播也可不在身边]
      性经历:
        type: *S_exp
        check:
          - 对应轴+1，不记时段场所; 近期次数性事后+1(换日脚本-1，勿预扣); 禁反推处女
          - 归并: 车震=隐奸; 下药昏睡=睡奸; 醒着暗示洗脑=催眠奸; 口交/体位/玩具不单开
          - 不双计: 绑打责罚主场=凌辱(即使有跳蛋); 只用项圈跳蛋=道具; 催眠≠睡奸; 时长不重复+1
          - 宠物/放置不单开: 牵引尾巴=道具; 装猫狗=扮演; 笼鞭罚跪=凌辱; 当众再叠露出
      开发度:
        type: *S_dev
        check:
          - 只口腔/胸/小穴/肛门; 档位0~5只升不降; 每回复最多1部位+1; 须实质进展，隔衣一蹭不升级
          - 档位+1时评语从该对象v2矩阵原样抄对应档(胸←胸部)，禁自撰; 未晋升部位不动
      生理:
        type: *S_phys
        性欲度:
          range: 0~100
          check: [挑逗下药道具+2~20，同类刺激当轮只取最高; 100高潮; 停止=0，持续回落50]
        体力:
          range: 0~100
          check: [活动性事消耗，休息恢复; <20昏睡并开睡奸]
        尿意:
          range: 0~100
          check: [每时段+20~30，饮水利尿+30~50; ≥60内急 ≥80求助 =100失禁后归0]
        异常状态:
          check: [下药/道具add，时效结束remove]
      直播:
        type: *S_stream
        check: [正文开播/下播以正文为准; 未开播标题空人数0，开播标题禁空; 看直播≠性直播经验; 粉丝身份勿写入本对象]
</变量更新规则>
