# MVU变量结构｜AI可见稿
# 可更新字段按本轮已完成事实修改；标为只读的字段由脚本维护。

世界信息:
  年历: str
  星期: str                         # 只读
  时间:
    时钟: str
    时段: 朝|昼|暮|夜|深夜          # 只读
  位置:
    区域: str
    场所: str
    私密度: int                     # 只读
  事件提示:
    "[事件名]": str                # 完成后remove；未完成则保留

玩家信息:
  体力: int
  金钱: int
  同行: 对象名|null
  工作:
    职业: str|null
    地点: str|null
    日收入: int
    今日已上班: bool
  居住地: str
  房产: "{[房产名]:{名称,区域,产权,描述}}"
  生活固定支出:
    "[支出项]":
      金额: int
      支付周期: 每日|每周|每月
  所在直播间: 对象名|null
  粉丝身份: "{[对象名]:{关注,累计打赏,牌子等级,牌子档位,牌子剩余天数,房管,禁言中,禁言剩余天数}}"
  背包:
    素材: "{[素材名]:{名称,类别,数量,来源,描述}}"
    消耗品: "{[消耗品名]:{名称,类别,数量,强度,描述}}"
    用品: "{[用品名]:{名称,类别,数量,佩戴,描述}}"

对象信息:
  "[对象名]":
    羁绊:
      好感度: int
      顺从度: int
      心情: str
    位置:
      区域: str
      场所: str
      私密度: int                   # 只读
    性经历:
      近期性经验次数: int           # 只读；脚本统计最近7日独立事件
      露出经验: &经验项
        次数: int
        可更新: bool                # 只读
      自慰经验: *经验项
      排泄调教经验: *经验项
      道具调教经验: *经验项
      凌辱调教经验: *经验项
      隐奸经验: *经验项
      青奸经验: *经验项
      睡奸经验: *经验项
      催眠奸经验: *经验项
      情趣扮演经验: *经验项
      盗摄经验: *经验项
      性直播经验: *经验项
    开发度:
      口腔: &开发部位
        档位: int                   # 只读，0~5
        进度: int                   # 距下一档的累计；升档门槛随档位递增，见下
        可更新: bool                # 只读
      胸: *开发部位
      小穴: *开发部位
      肛门: *开发部位
    生理:
      性欲度: int
      体力: int
      尿意: int
      异常状态:
        "[状态名]":
          到期条件: str
    直播:
      开播: bool
      标题: str
      热度: int                     # 只读
      粉丝数: int                   # 只读

# 关键更新规则
# - 性经验：只有可更新=true且对应事件完整结束时，次数+1；每项本轮最多+1。
# - 性经验可更新由脚本按1日CD维护，AI不改；可更新=false时保持次数不变。
# - 开发度：档位、可更新只读；只有可更新=true且发生实质进展时增加进度。
# - 开发度每轮最多更新一个部位，单次建议+1~20；升档和每日上限由脚本处理。
# - 升档门槛逐档递增：0→1需40，1→2需80，2→3需130，3→4需190，4→5需260；不是固定100。
#   AI不用自己算门槛，进度够了脚本会换成档位；只按剧情实际进展给+1~20即可。
# - 固定支出：AI只登记金额与周期；脚本到期时写入事件提示。
# - 账单支付完成时扣除金钱并remove事件；余额不足则保留。
# - 事件提示由AI与脚本共用，AI根据正文判断完成时间。

# - 异常状态：优先写「YYYY年M月D日 HH:mm 到期移除」；少数条件型状态写明确解除条件，条件达成后remove。
