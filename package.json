{
  "name": "glass-hud",
  "private": true,
  "version": "1.0.0",
  "description": "Pixel-accurate replica of the frosted-glass status bar from 原型/原型示意图.png",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "diff": "node scripts/diff.mjs",
    "plate": "node scripts/shot-plate-map.mjs",
    "plate:probe": "node scripts/probe-plate.mjs",
    "plate:perf": "node scripts/perf-plate.mjs",
    "plate:fit": "node scripts/check-fit.mjs",
    "net": "node scripts/check-net.mjs",
    "net:shot": "node scripts/shot-net.mjs",
    "net:stations": "node scripts/probe-stations.mjs",
    "plate:phase": "node scripts/shot-phase.mjs",
    "portrait": "node scripts/shot-portrait.mjs",
    "drawer": "node tools/shot_drawer.mjs",
    "profile": "node tools/shot_profile.mjs",
    "gifts": "node tools/shot_gifts.mjs",
    "ppages": "node tools/shot_portrait_pages.mjs",
    "smoke": "node tools/smoke_pages.mjs",
    "responsive": "node scripts/check-responsive.mjs",
    "arcade": "node scripts/check-arcade-mobile.mjs",
    "arcade:shots": "node scripts/check-arcade-mobile.mjs --shots",
    "arcade:states": "node scripts/shot-arcade-states.mjs",
    "arcade:rotated": "node scripts/check-arcade-rotated.mjs",
    "embed": "node scripts/check-embed.mjs",
    "tavern:real": "node scripts/check-tavern-real.mjs",
    "tavern:pages": "node scripts/check-tavern-mobile-pages.mjs",
    "split": "node scripts/check-split.mjs",
    "phone:build": "node phone/build.mjs",
    "phone:check": "node phone/build.mjs --check",
    "phone:shot": "node tools/shot_phone.mjs",
    "assets": "python tools/export_assets.py && python tools/make_bg_plate.py && python tools/export_item_icons.py && python tools/export_gift_icons.py"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "vite": "^7.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
