- <% if (x.直连) { %>★<% } else { %>　<% } %><%= x.n.name %>｜<%= x.文 %>｜<%= 类型名[x.n.arch] || x.n.arch %><% if (功能文(x.n.flag)) { %>｜<%= 功能文(x.n.flag) %><% } %>
<%_ }); if (!临近.length) { _%>
