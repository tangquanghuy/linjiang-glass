<%_ 自建列表.forEach(n => { _%>
- <%= n.name %>｜<%= n.district || 区名(n.plate) %>｜接驳 <%= n.anchorName || 名(n.anchor) %> <%= n.accessKm %>km｜<%= 类型名[n.arch] || n.arch %>｜私密度<%= n.privacy %><% if (功能文(n.flag)) { %>｜<%= 功能文(n.flag) %><% } %>
