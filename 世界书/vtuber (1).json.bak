9],\"dt_airport\":[26,0,8,9,11,26,8,2],\"wx_teahouse\":[50,3,10,18,19,79,24,8.6],\"wx_script\":[55,3,12,19,22,91,27,9],\"mh_cinema\":[78,5,16,33,54,197,59,20.8],\"lx_canteen\":[80,5,18,33,53,268,80,20.5],\"ys_station\":[52,4,11,21,38,187,56,14.3],\"pj_morning\":[71,5,14,30,39,178,53,18.9],\"qp_visitor\":[88,6,13,35,69,308,92,22.2],\"qp_cable\":[101,6,17,38,71,321,96,23.2],\"qp_teahouse\":[112,6,20,35,72,332,100,24],\"gl_cafe\":[66,2,13,24,27,114,34,10]},\n    dt_farmhouse: {\"lx_print\":[65,4,14,30,51,234,70,18.1],\"gl_parcel\":[43,2,7,16,19,74,22,7.1],\"mh_mart\":[57,4,10,27,35,156,47,17.2],\"xz_esports\":[49,2,6,22,29,100,30,9.8],\"dt_gas\":[29,2,6,11,11,32,10,4.5],\"xz_sound_studio\":[44,2,5,21,28,95,28,9.4],\"xz_theatre\":[48,5,5,20,29,116,35,11.3],\"gl_pet\":[40,3,7,18,22,82,24,10.3],\"mh_hospital\":[58,4,8,26,34,158,47,11.9],\"lx_lab\":[76,6,10,34,55,253,76,23.8],\"ys_rdpark\":[59,5,10,27,35,155,46,17.9],\"wx_dye\":[17,2,3,8,11,28,8,2.2],\"dt_outlet\":[19,2,3,9,11,33,10,3.7],\"dt_airport\":[12,0,4,7,11,12,4,0.9],\"wx_teahouse\":[30,3,5,12,12,43,13,5.8],\"wx_script\":[36,3,6,13,14,54,16,6.2],\"mh_cinema\":[59,5,10,27,35,162,49,18],\"lx_canteen\":[60,4,12,30,51,233,70,17.7],\"ys_station\":[33,4,5,18,35,153,46,11.6],\"pj_morning\":[52,4,9,24,32,142,43,16.1],\"qp_visitor\":[68,6,7,36,59,273,82,19.4],\"qp_cable\":[81,6,11,39,62,286,86,20.4],\"qp_teahouse\":[92,6,15,40,65,297,89,21.2],\"gl_cafe\":[44,2,7,17,20,78,23,7.2]},\n  }\n};\n","constant":false,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":-999,"position":0,"disable":true,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":19,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"20":{"uid":20,"key":[],"keysecondary":[],"comment":"地图加载","content":"---\n<%_\n/* ============================================================\n * 《地图加载 - 临江市》\n * 读 stat_data.世界信息.位置 → 在《地图静态资料 - 临江市》里定位节点\n * → 把这一格周围的路网、同区地点、跨区通勤、住所与工作通勤摊给 AI。\n * 全城 120 个节点不全给，只给\"站在这里看得见、想得到\"的那一圈。\n * ============================================================ */\nconst __lj_raw = _.cloneDeep(getMessageVar('stat_data', { defaults: {} }));\nconst __lj_off = String(_.get(__lj_raw, '系统配置.地图加载', '') || '').trim() === '关';\nif (!__lj_off) {\ntry {\nconst data = __lj_raw;\n\n/* ---- 取静态资料 ---- */\nconst MAP = await (async () => {\n  const log = (m) => { try { console.log(`[临江市地图加载] ${m}`); } catch (_) {} };\n  const names = ['地图静态资料 - 临江市', '地图静态资料 - 临江市.js', '地图静态资料', '地图静态资料.js'];\n  let raw = '';\n  for (const n of names) {\n    raw = String(await getWorldInfo(n) || '');\n    if (raw.trim()) break;\n  }\n  if (!raw.trim()) { log('未找到《地图静态资料 - 临江市》条目'); return null; }\n  try {\n    return new Function(`${raw}\\n; return typeof LJ_MAP_DATA !== 'undefined' ? LJ_MAP_DATA : null;`)();\n  } catch (e) {\n    log('解析静态资料失败: ' + (e && e.message ? e.message : e));\n    return null;\n  }\n})();\n\nif (MAP && MAP.nodes) {\n\n/* ---- 变量 ---- */\nconst 位置 = _.get(data, '世界信息.位置', {}) || {};\nconst 区域原文 = String(位置.区域 || '').trim();\nconst 场所 = String(位置.场所 || '').trim();\nconst 私密度变量 = _.get(位置, '私密度', null);\nconst 时钟 = String(_.get(data, '世界信息.时间.时钟', '') || '').trim();\nconst 时段 = String(_.get(data, '世界信息.时间.时段', '') || '').trim();\nconst 年历 = String(_.get(data, '世界信息.年历', '') || '').trim();\nconst 玩家 = _.get(data, '玩家信息', {}) || {};\nconst 体力 = Number(_.get(玩家, '体力', 0)) || 0;\nconst 金钱 = Number(_.get(玩家, '金钱', 0)) || 0;\nconst 工作 = _.get(玩家, '工作', {}) || {};\nconst 职业 = String(工作.职业 || '').trim();\nconst 工作地点 = String(工作.地点 || '').trim();\nconst 日收入 = Number(工作.日收入 || 0) || 0;\nconst 今日已上班 = 工作.今日已上班 === true;\nconst 居住地 = String(_.get(玩家, '居住地', '') || '').trim();\nconst 同行 = _.get(玩家, '同行', null);\n\n/* ---- 归一化与匹配 ---- */\nfunction 归一(t) {\n  return String(t || '')\n    .normalize('NFKC')\n    .replace(/[\\s_]+/g, '')\n    .replace(/[·・‧.．、]/g, '')\n    .replace(/[()（）【】\\[\\]「」『』“”'']/g, '')\n    .toLowerCase();\n}\nfunction 拆区域(t) {\n  const parts = String(t || '').split(/[·・‧>＞\\/｜|,，]/).map(s => s.trim()).filter(Boolean);\n  return { 大: parts[0] || '', 子: parts.length > 1 ? parts[parts.length - 1] : '' };\n}\nconst 区域 = 拆区域(区域原文);\n\nconst NODES = MAP.nodes;\nconst 全部ID = Object.keys(NODES);\nfunction 节点(id) {\n  const a = NODES[id];\n  if (!a) return null;\n  return { id, name: a[0], plate: a[1], arch: a[2], privacy: a[3], hours: a[4], flag: a[5] || '' };\n}\nfunction 别名(id) { return [NODES[id][0], id]; }\n/** 精确 → 包含 → 打分。地图节点名和变量里写的区域名常常只是部分重合 */\nfunction 找节点(候选) {\n  const list = 候选.map(x => String(x || '').trim()).filter(Boolean);\n  for (const t of list) {\n    const k = 归一(t);\n    if (!k) continue;\n    for (const id of 全部ID) {\n      if (别名(id).some(a => 归一(a) === k)) return id;\n    }\n  }\n  let best = null;\n  for (const t of list) {\n    const k = 归一(t);\n    if (k.length < 2) continue;\n    for (const id of 全部ID) {\n      for (const a of 别名(id)) {\n        const na = 归一(a);\n        if (na.length < 2) continue;\n        if (!na.includes(k) && !k.includes(na)) continue;\n        const score = Math.min(na.length, k.length) * 10 - Math.abs(na.length - k.length);\n        if (!best || score > best.score) best = { id, score };\n      }\n    }\n  }\n  return best ? best.id : null;\n}\nfunction 找区(名) {\n  const k = 归一(名);\n  if (!k) return null;\n  const ds = MAP.districts || [];\n  let hit = ds.find(d => [d.name, d.varName, d.label].some(x => 归一(x) === k));\n  if (hit) return hit;\n  hit = ds.find(d => [d.name, d.varName, d.label].some(x => {\n    const nx = 归一(x);\n    return nx.length >= 2 && (nx.includes(k) || k.includes(nx));\n  }));\n  return hit || null;\n}\n\n/* ---- 定位 ---- */\nconst 当前区 = 找区(区域.大) || 找区(区域原文);\nconst 当前ID = 找节点([区域.子, 区域原文, 场所]);\nconst 当前 = 当前ID ? 节点(当前ID) : null;\nconst 所在区 = 当前 ? (MAP.districts || []).find(d => d.key === 当前.plate) : 当前区;\n\n/* ---- 文字表 ---- */\nconst 类型名 = {\n  nature: '自然山水', hotspring: '温泉汤院', medical: '医疗', commercial: '商业',\n  adult: '成人场所', academy: '院校科研', live: '演艺直播', living: '生活起居',\n  culture: '人文古迹', craft: '手作工坊', traffic: '交通设施', public: '公共场所'\n};\nconst 私密说明 = ['全开放', '街面开放', '有人但不专注', '半私密', '隐蔽', '完全私密'];\nconst 功能名 = { 采: '可采集', 约: '可约会', 工: '可打工', 店: '有商店', 岗: '有正式岗位' };\nfunction 功能文(flag) {\n  const s = String(flag || '');\n  const out = [];\n  for (const k of ['采', '约', '工', '店', '岗']) if (s.includes(k)) out.push(功能名[k]);\n  return out.join('／');\n}\n/** 静态资料里时段压成了单字串（深夜→深）。展开成带分隔符的列表，别糊成\"朝昼暮夜深夜\"一坨 */\nfunction 时段文(h) {\n  const s = String(h || '');\n  if (!s) return '未标注';\n  const list = [...s].map(c => (c === '深' ? '深夜' : c));\n  return list.length >= 5 ? '全时段' : list.join('/');\n}\nfunction 开放中(h) {\n  const s = String(h || '');\n  if (!s || !时段) return null;\n  return s.includes(时段 === '深夜' ? '深' : 时段);\n}\nfunction 名(id) { const n = 节点(id); return n ? n.name : id; }\nfunction 区名(plate) {\n  const d = (MAP.districts || []).find(x => x.key === plate);\n  return d ? d.name : plate;\n}\n/** 直连行：[to, km, 步行分, 步行体力, 公交分, 公交元, 公交体力, 打车分, 打车元] */\nfunction 直连行文(r) {\n  const t = [`步行${r[2]}分/体力-${r[3]}`];\n  if (r[4] && r[4] < r[2]) t.push(`公交地铁${r[4]}分/${r[5]}元/体力-${r[6]}`);\n  t.push(`打车${r[7]}分/${r[8]}元`);\n  return t.join('｜');\n}\n/** 枢纽行：[公交分,公交元,公交体力, 打车分,打车元, 步行分,步行体力, km] */\nfunction 枢纽行文(r) {\n  return `公交地铁${r[0]}分/${r[1]}元/体力-${r[2]}｜打车${r[3]}分/${r[4]}元｜步行${r[5]}分/体力-${r[6]}`;\n}\n\n/* ---- 周边 ---- */\nconst 直连 = (当前 && MAP.link[当前.id]) ? MAP.link[当前.id] : [];\nconst 步行圈 = (当前 && MAP.near[当前.id]) ? MAP.near[当前.id] : [];\n/** 次邻：沿直连支路走两跳，去掉直连和自己，按两段直线里程之和排序 */\nconst 次邻 = (() => {\n  if (!当前) return [];\n  const 直 = new Set(直连.map(r => r[0]));\n  const best = new Map();\n  直连.forEach(a => {\n    const mid = a[0];\n    (MAP.link[mid] || []).forEach(b => {\n      const far = b[0];\n      if (far === 当前.id || 直.has(far)) return;\n      const km = Math.round((a[1] + b[1]) * 10) / 10;\n      const old = best.get(far);\n      if (!old || km < old.km) best.set(far, { id: far, via: mid, km, min: a[2] + b[2], st: a[3] + b[3] });\n    });\n  });\n  return [...best.values()].sort((x, y) => x.km - y.km).slice(0, 8);\n})();\n/* 只激活\"临近 + 次临\"这一圈。同区更远的点不列：\n   要去那儿就先走过去，届时它自己会变成临近节点；\n   现在列出来只会白白触发一堆用不上的地点详情条目。\n\n   直连支路和步行圈本来是两张表，但 RNG 只给每个点 2~3 个直连邻居，\n   这两张表内容高度重叠，分开输出等于把同一批名字念两遍。\n   合成一张按步行时长排的\"临近\"，直连的打星号，需要坐车的才补公交/打车。 */\nconst 临近 = (() => {\n  if (!当前) return [];\n  const 直 = new Map(直连.map(r => [r[0], r]));\n  const seen = new Set();\n  const rows = [];\n  const 收 = (id, min, st) => {\n    if (seen.has(id) || !NODES[id]) return;\n    seen.add(id);\n    const d = 直.get(id);\n    const 段 = [`步行${min}分/体力-${st}`];\n    // 走得动就不提车；超过 20 分钟才值得给公交和打车\n    if (d && min > 20) {\n      if (d[4] && d[4] < min) 段.push(`公交地铁${d[4]}分/${d[5]}元/体力-${d[6]}`);\n      段.push(`打车${d[7]}分/${d[8]}元`);\n    }\n    rows.push({\n      n: 节点(id),\n      直连: !!d,\n      文: (d ? `${d[1]}km｜` : '') + 段.join('｜'),\n      min\n    });\n  };\n  步行圈.forEach(r => 收(r[0], r[1], r[2]));\n  直连.forEach(r => 收(r[0], r[2], r[3]));\n  return rows.sort((a, b) => a.min - b.min);\n})();\n\n/** 只留经过当前区的线路；线路第三项是它途经的底板 key */\nconst 本区地铁 = (MAP.metro || []).filter(m =>\n  所在区 && Array.isArray(m[2]) && m[2].includes(所在区.key)\n);\n\n/* ---- 跨区通勤 ---- */\nconst 跨区 = (() => {\n  if (!当前) return [];\n  const row = MAP.hub[当前.id] || {};\n  return (MAP.districts || [])\n    .filter(d => d.key !== 当前.plate)\n    .map(d => ({ d, r: row[d.key] || null }))\n    .filter(x => x.r)\n    .sort((a, b) => a.r[0] - b.r[0]);\n})();\n\n/* ---- 住所与工作 ---- */\nconst 住所ID = 找节点([拆区域(居住地).子, 居住地]);\nconst 工作ID = 工作地点 ? 找节点([拆区域(工作地点).子, 工作地点]) : null;\nconst 住所 = 住所ID ? 节点(住所ID) : null;\nconst 工作节点 = 工作ID ? 节点(工作ID) : null;\n/* 房租、押金、售价、门槛、岗位薪酬班次一概不在这里——\n   那些写在按关键字触发的地点详情条目里，玩家走到哪儿触发哪儿，\n   放进每轮注入只会和详情打架。 */\n/** 通勤：住宅×工作矩阵里有就取精确值；没有就退回\"到对方所在区枢纽\"的估值 */\nconst 通勤 = (() => {\n  if (!住所ID || !工作ID || 住所ID === 工作ID) return null;\n  const exact = MAP.commute && MAP.commute[住所ID] && MAP.commute[住所ID][工作ID];\n  if (exact) return { 精确: true, r: exact };\n  const wp = 工作节点 ? 工作节点.plate : '';\n  const est = MAP.hub[住所ID] && wp ? MAP.hub[住所ID][wp] : null;\n  return est ? { 精确: false, r: est, 经: 区名(wp) + '枢纽' } : null;\n})();\n\n\n/** 从当前位置到某个地点：直连 → 步行圈 → 对方区枢纽估值 */\nfunction 到某处(目标ID) {\n  if (!当前 || !目标ID || 目标ID === 当前.id) return null;\n  const d = 直连.find(r => r[0] === 目标ID);\n  if (d) return { 精确: true, 文: 直连行文(d), km: d[1] };\n  const c = MAP.commute && MAP.commute[目标ID] && MAP.commute[目标ID][当前.id];\n  if (c) return { 精确: true, 文: 枢纽行文(c), km: c[7] };\n  const c2 = MAP.commute && MAP.commute[当前.id] && MAP.commute[当前.id][目标ID];\n  if (c2) return { 精确: true, 文: 枢纽行文(c2), km: c2[7] };\n  const n = 步行圈.find(r => r[0] === 目标ID);\n  if (n) return { 精确: true, 文: `步行${n[1]}分/体力-${n[2]}`, km: null };\n  const tgt = 节点(目标ID);\n  const h = tgt && MAP.hub[当前.id] ? MAP.hub[当前.id][tgt.plate] : null;\n  if (h) return { 精确: false, 文: 枢纽行文(h), km: h[7], 经: 区名(tgt.plate) + '枢纽' };\n  return null;\n}\nconst 回家 = 到某处(住所ID);\nconst 去上班 = 到某处(工作ID);\n_%>\n\n<map_info>\n城市：<%= MAP.meta.city %>（<%= MAP.meta.year %>年）｜<%= MAP.meta.span %>\n时间：<%= 年历 %> <%= 时钟 %>，时段「<%= 时段 %>」\n时段划分：<%= MAP.meta.periods %>\n位置：<%= 区域原文 || '未知' %><% if (场所) { %> · <%= 场所 %><% } %>\n<%_ if (当前) { _%>\n节点：<%= 当前.name %>（<%= 类型名[当前.arch] || 当前.arch %>｜<%= 所在区 ? 所在区.name + '·' + 所在区.label : '' %>）｜开放 <%= 时段文(当前.hours) %>｜私密度 <%= 当前.privacy %>／5 <%= 私密说明[当前.privacy] || '' %><% if (功能文(当前.flag)) { %>｜<%= 功能文(当前.flag) %><% } %><% if (开放中(当前.hours) === false) { %>\n※当前「<%= 时段 %>」不在开放时段，正文要处理闭门、值班或另找地方<% } %><% if (私密度变量 !== null && Number(私密度变量) !== Number(当前.privacy)) { %>\n※变量私密度写的是 <%= 私密度变量 %>，与节点默认值不同，按变量走<% } %>\n\n临近（★=有直连支路；按步行时长排）：\n<%_ 临近.forEach(x => { _%>\n- <% if (x.直连) { %>★<% } else { %>　<% } %><%= x.n.name %>｜<%= x.文 %>｜<%= 类型名[x.n.arch] || x.n.arch %><% if (功能文(x.n.flag)) { %>｜<%= 功能文(x.n.flag) %><% } %>\n<%_ }); if (!临近.length) { _%>\n- 三公里内没有别的地点，出门就得靠车。\n<%_ } _%>\n<%_ if (次邻.length) { _%>\n次临（沿支路两跳）：\n<%_ 次邻.forEach(x => { const n = 节点(x.id); _%>\n- <%= n.name %>｜约<%= x.km %>km｜经 <%= 名(x.via) %>｜步行合计<%= x.min %>分/体力-<%= x.st %>\n<%_ }); _%>\n<%_ } _%>\n出远门（到各区枢纽，按公交地铁时长排；更远或更细的目标从枢纽接着算）：\n<%_ 跨区.forEach(x => { _%>\n- <%= x.d.name %>（<%= x.d.bearing %>）→ <%= x.d.hubName %>｜<%= x.r[7] %>km｜<%= 枢纽行文(x.r) %>\n<%_ }); _%>\n<%_ } else { _%>\n节点：未命中地图节点\n定位回退：\n- 「位置.区域」要写成「{行政区/风景区} · {地图节点名}」，子区域必须是静态资料里存在的节点名。\n- 当前写法「<%= 区域原文 || '空' %>」没匹配上，先把它改成最接近的正式节点名，再继续叙事。\n<%_ if (当前区) { _%>\n- 大区域匹配到了 <%= 当前区.name %>（<%= 当前区.bearing %>｜<%= 当前区.label %>），这个区的节点有：<%= (当前区.nodes || []).map(id => 名(id)).join('、') %>\n<%_ } _%>\n<%_ } _%>\n\n<%_ if (本区地铁.length) { _%>\n经过本区的轨道（全网 5 条线，其余线路要用时问）：\n<%_ 本区地铁.forEach(m => { _%>\n- <%= m[0] %>：<%= m[1] %>\n<%_ }); _%>\n<%_ } _%>\n过江：临江自西南向东北斜贯城市北部；江北只有浦江区，靠临江大桥（人可走）与过江隧道（人不可走）连通。\n\n当前状态：\n- 当前体力 <%= 体力 %>/100<% if (体力 < 20) { %>　※已进入透支档，按<求职住房与体力规则>只允许短距离移动、进食与回住所<% } else if (体力 < 40) { %>　※疲惫档，长距离步行会直接见底<% } %>\n- 金钱 <%= 金钱 %> 元\n- 同行：<%= 同行 ? 同行 : '独行' %>\n- 住所：<% if (住所) { %><%= 住所.name %>（<%= 区名(住所.plate) %>）<% } else { %><%= 居住地 || '未设置' %>（未命中地图节点）<% } %>\n<%_ if (回家) { _%>\n- 回住所：<%= 回家.文 %><% if (回家.km) { %>｜<%= 回家.km %>km<% } %><% if (!回家.精确) { %>（经<%= 回家.经 %>估值）<% } %>\n<%_ } _%>\n- 工作：<% if (职业) { %><%= 职业 %> @ <%= 工作地点 || '未写地点' %>｜日收入<%= 日收入 %>元｜今日<%= 今日已上班 ? '已上班' : '未上班' %><% } else { %>无业<% } %>\n<%_ if (去上班) { _%>\n- 去上班：<%= 去上班.文 %><% if (去上班.km) { %>｜<%= 去上班.km %>km<% } %><% if (!去上班.精确) { %>（经<%= 去上班.经 %>估值）<% } %>\n<%_ } else if (通勤) { /* 人在住所时上一行已经等于通勤，不重复打印 */ _%>\n- 住所↔工作单程：<%= 枢纽行文(通勤.r) %>｜<%= 通勤.r[7] %>km<% if (!通勤.精确) { %>（经<%= 通勤.经 %>估值）<% } %>\n<%_ } _%>\n\n出行参数（未列出的路线按这个自己估，别拍脑袋）：\n- 均速 km/h：步行 <%= MAP.travel.speed.步行 %>｜公交 <%= MAP.travel.speed.公交 %>｜地铁 <%= MAP.travel.speed.地铁 %>｜驾车干道 <%= MAP.travel.speed.驾车干道 %>｜快速路 <%= MAP.travel.speed.驾车快速路 %>\n- 固定开销（分钟）：公交候车 <%= MAP.travel.wait.公交候车 %>｜地铁进出站 <%= MAP.travel.wait.进出站 %>｜等出租 <%= MAP.travel.wait.打车等车 %>｜取车找车位 <%= MAP.travel.wait.取车找位 %>\n- 票价：地铁 <%= MAP.travel.fare.地铁 %>｜公交 <%= MAP.travel.fare.公交 %>｜出租 <%= MAP.travel.fare.出租 %>\n- 消耗公式：<%= MAP.travel.stamina %>（上面各行的「体力-N」都是按这个算出来的实扣值）\n\n移动铁律：\n- 只能沿临近／次临节点或干道轨道逐段推进，禁止跨区瞬移，也禁止无视中间节点。\n- 上面列出的时长、票价、体力是路网算出来的，正文与变量结算一律以它为准，不得另编数字。\n- 表里没有的路线：先判断要经过哪几个已列节点，再按出行参数累加，不得凭感觉写\"十几分钟就到\"。\n- 跨江只有临江大桥和过江隧道两条；步行、骑行不能走隧道。\n- 到达新节点必须同步更新 位置.区域 为「{行政区/风景区} · {节点名}」，场所写节点内部的小地点。\n- 深夜或非开放时段抵达要先处理\"关门/末班车已过/无人值守\"，不能默认照常营业。\n- 本条目只给\"路怎么走\"。地点里面长什么样、有什么本地条件、房租多少、岗位开多少钱，看那个地点自己的详情条目；详情没触发就别自己编。\n- 找工作、换住所、体力消耗与恢复的流程走<求职住房与体力规则>；上面这些数字是那套规则的输入。\n- 采集素材、把素材做成消耗品或用品、以及道具用掉之后怎么结算，走<道具制作与使用规则>。标了「可采集」只代表这里产素材，具体产什么看该地点详情；素材本身没有效果，要先做成成品才生效。\n\n</map_info>\n<%_\n} else {\n_%>\n<map_info>\n\n地图静态资料未加载：请确认世界书里存在名为「地图静态资料 - 临江市」的条目，且内容以 var LJ_MAP_DATA = {...} 开头。\n本轮不要凭空编造节点名、距离与通勤时长。\n\n</map_info>\n<%_\n}\n} catch (e) {\n  try { console.log(`[临江市地图加载] 执行失败: ${e && e.stack ? e.stack : e}`); } catch (_) {}\n}\n}\n_%>\n","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":31,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":20,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"21":{"uid":21,"key":["直播","弹幕","主播"],"keysecondary":[],"comment":"⚙️直播间格式","content":"<直播间卡片规则>\n直播间卡片:\n  task: 玩家在看直播时，正文用<直播间>标签输出一段弹幕流，还原观众视角的弹幕区。主播说什么做什么，照常在正文里演绎，卡片里不写主播的话。\n\n  时机:\n    出卡: 打开或切换直播间的那轮，以及此后每轮仍在看直播时，各一张\n    不出卡: 主播没开播、玩家已退出直播间、玩家与主播线下同场（那时用<突发事件>）\n    一轮只出一张\n\n  内容:\n    - 对标现实直播间的真实弹幕风格\n    - **必须发散**，在不违背格式要求前提下，弹幕内容、对话形式，都必须发散，严禁刻板重复内容和其他任何形式\n\n  写法:\n    主播: 用白名单短名\n    弹幕: 单独一行作分节，其后每条以「- 」开头\n    - **一次至少30条**。字段只有 类型/名字/牌子/礼物/数量/金额/内容，同行空格分隔，顺序随意\n    - 内容里不要出现「字段名+冒号」，只能用「」\n\n  牌子:\n    - 写法「牌子: 名字 等级」，如 牌子: 雏草姬 12。等级 1~20\n    - 只在 普通/舰长/提督/总督 四种类型上生效\n    - 不要全部弹幕只写当前主播的牌子。可以有无牌子，也可以戴别家的牌子\n    - 同一个观众ID在同一轮里出现多次，牌子和等级必须一致\n    - 等级要和身份对得上：总督/提督一般 15 以上，舰长 10 上下，路人个位数到十几\n\n  类型:\n    普通: 名字+内容（+牌子）。弹幕流主体\n    舰长/提督/总督: 名字+内容（+牌子）。带舰队徽章，频率远低于普通，总督一轮最多1条\n    礼物: 名字+礼物+数量。礼物名取自白名单，数量只用 1/10/66/233\n    醒目留言: 名字+金额+内容。金额只用 30/50/100\n    进入: 只要名字，渲染成「XX 来了」，一轮1~2条\n    系统: 只要内容。平台提示，如禁言、超管警告、上舰播报\n\n  format: |-\n    <LiveRoom>\n    主播: ${短名}\n    弹幕:\n    - 类型: 普通 名字: ${观众ID} 牌子: ${牌子名} ${1-20} 内容: ${内容}\n    - 类型: 礼物 名字: ${观众ID} 礼物: ${礼物名} 数量: ${1/10/66/233}\n    - 类型: 醒目留言 名字: ${观众ID} 金额: ${30/50/100} 内容: ${内容}\n   </LiveRoom>\n\n  示例:\n    <LiveRoom>\n    主播: 塔菲\n    弹幕:\n    - 类型: 进入 名字: 湖滨卡座\n    - 类型: 普通 名字: 云庭7楼 牌子: 雏草姬 12 内容: 来了，电梯刚好卡在十三层\n    - 类型: 普通 名字: 洲门站末班 内容: 这段又开始了\n    - 类型: 舰长 名字: 阿初 牌子: 雏草姬 16 内容: 今日发型是认真的\n    - 类型: 礼物 名字: 鼓岭晚风 礼物: 干杯 数量: 10\n    - 类型: 普通 名字: 明湖不打伞 内容: 卡了还是我这边卡了\n    - 类型: 醒目留言 名字: 西洲加班人 金额: 30 内容: 加班到现在，求一句辛苦了\n    - 类型: 提督 名字: 深海灯 牌子: 雏草姬 19 内容: 节奏稳，别被火箭带跑\n    - 类型: 普通 名字: 时雨路过 牌子: 雨户 8 内容: 羽衣今晚不播，我来串门\n    - 类型: 普通 名字: 乌溪三号线 牌子: 雏草姬 4 内容: 复读：别被火箭带跑\n    - 类型: 系统 内容: 匿名棺 已被禁言\n   </LiveRoom>\n\n  主播与牌子（主播字段只能填左列短名，牌子字段用右列的名字加等级）:\n    东雪莲: 棺人痴\n    塔菲: 雏草姬\n    沙花叉: 饲养员\n    时雨羽衣: 雨户\n    红蔷薇: 亲爱的\n    斯黛拉: 小猪\n    璃亚梦: 病友\n\n  礼物白名单: [小心心、辣条、干杯、心愿盲盒、情书、小飞机、摩天大楼、火箭]\n</直播间卡片规则>\n","constant":false,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":1,"position":4,"disable":false,"ignoreBudget":false,"excludeRecursion":true,"preventRecursion":true,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":0,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":21,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"22":{"uid":22,"key":[],"keysecondary":[],"comment":"⚙️道具制作与使用","content":"<道具制作与使用规则>\n本系统对标 DLsite 现代都市题材 R18 SLG（融合调教、催眠、露出、恶堕、媚药、憋尿等玩法）。核心乐趣在于:获得/调配特殊道具 -> 施加异常状态 -> 突破日常耻度/引发情境危机 -> 露出宠物或其他情趣Play -> 心理与肉体变化\n本规则定义素材加工、消耗品使用结算、用品佩戴与分支解锁机制，对标现代都市题材调教与露出类黄游体系。\n\n一、 背包三栏定义与流转\n1. 素材：原料，不可直接生效，仅用于合成。分为植物、动物、矿物、化学、织物、其他六类。\n2. 消耗品：一次性药剂、食品、饮品或日用品。使用后改变生理数值（体力、性欲度、尿意）并附加异常状态，数量归零时移除。\n3. 用品：耐用情趣道具、拘束器具、摄影器材或定制服装。不产生数值，通过「佩戴」状态（开启或关闭）解锁特定玩法门槛。\n\n二、 道具制作前置与强度判定\n1. 制作要素：\n   - 原料：单件成品消耗二至三样不同素材，每样一至二份。\n   - 场地与配方强度上限：\n     * 无场地（野外、车内）：强度上限为1（仅限基础食物日用）。\n     * 自家厨卫：强度上限为3（食物、饮品、基础日用）。\n     * 专业场地（理化实验室、配药房、染坊木案、裁缝台）：强度上限为4。\n     * 专业场地且持有对应配方：强度上限为5（全游戏最高档位管制药剂与专业器具）。\n     * 无对应配方时，制作上限锁定为2。\n2. 核心执行铁律：\n   - 一次制作只出一件事：单次回合不得同时完成采集、制作与使用；制作过程必须独立结算。\n   - 素材未就绪中止：点料发现背包素材不足，当场中止制作，不降格替代。\n3. 制作五步流程：\n   - 明确制作目标与动机。\n   - 清点背包素材，缺料则当场中止。\n   - 按场地、配方与素材上限取最小值确定最终强度（降档出成品属正常过程）。\n   - 扣减玩家体力（五至十五点）并推进时间，借用场地扣除场地费。\n   - 变量结算：扣减素材，生成成品。\n4. 代工机制：交由特定技艺人物代做，提供素材并支付市价三成至五成工费，强度由对方技艺与场地决定，需经历委托至取货流程。\n\n三、 经典合成路线与配方范例(仅作启发，不要偷懒直接拿去用)\n1. 催情向药物（植物 + 化学）：\n   - 配方：蓝色野生花瓣（植物）+ 纯净露水/实验溶剂（化学）\n   - 成品：蓝花催情露（消耗品·药物）\n   - 效果：随强度提升性欲度；高阶附加「蓝色花粉催情中」。\n2. 利尿向药物（植物 + 化学）：\n   - 配方：野生利尿草药（植物）+ 特种提取溶剂（化学）\n   - 成品：浓缩利尿滴剂（消耗品·药物）\n   - 效果：大幅提升尿意；高阶附加「极度憋尿」。\n3. 安眠镇静向药物（植物 + 化学/其他）：\n   - 配方：安眠野生伞菌（植物）+ 高浓度纯粮酒/镇静试剂（化学）\n   - 成品：深眠萃取液（消耗品·药物）\n   - 效果：大幅削减体力；体力归底后附加「深度昏睡」。\n4. 情趣与束缚用品（织物 + 织物/矿物/化学）：\n   - 配方：高韧性棉绳（织物）×2 + 润滑软膏（化学）在工坊制作专业束缚绳（用品·器具）\n   - 配方：戏曲绸缎/弹力面料（织物）+ 细棉绳（织物）在裁缝台制作微型系带比基尼/紧身胶衣（用品·服装）\n5. 润滑与护理日用（化学 + 化学/其他）：\n   - 配方：亲肤凝胶原浆（化学）+ 药用凡士林（化学）高润滑调和油（消耗品·日用）\n\n四、 消耗品生理数值与异常状态结算表\n1. 食物类（恢复体力）：\n   - 强度 1 至 5 依次恢复：+5 / +10 / +15 / +20 / +25 点体力。\n2. 饮料类（微调体力 + 推进尿意）：\n   - 体力恢复：强度 1 至 5 依次 +3 / +5 / +8 / +10 / +12。\n   - 尿意增加：强度 1 至 5 依次 +10 / +15 / +20 / +30 / +40。\n   - 酒精效果：含酒饮品强度 2 及以上附加状态「微醺」。\n3. 药物类（驱动核心性癖机制）：\n   - 催情向（增加性欲度）：强度 1 至 5 依次 +5 / +10 / +15 / +20 / +20。\n     * 强度 4：附加「蓝色花粉催情中」（持续一时段，后续每时段性欲 +10）。\n     * 强度 5：附加「蓝色花粉催情中」（跨越两个时段，后续每时段性欲 +15，睡眠不清除）。\n   - 安眠向（削减体力）：强度 1 至 5 依次 -15 / -25 / -35 / -45 / -55。\n     * 结算后体力低于 20 点时，强制附加状态「深度昏睡」（解锁无防备睡奸、盗摄、全裸摆布）。\n   - 利尿向（增加尿意）：强度 1 至 5 依次 +20 / +30 / +35 / +40 / +50。\n     * 结算后尿意达到 80 点及以上时，强制附加状态「极度憋尿」（解锁排泄调教、憋尿隐奸、公厕脱管玩法；达 100 判定失禁并归零）。\n   - 暗示向（精神干预）：强度 3 及以上方可制作，直接附加状态「暗示中」，不改动基础生理数值。\n4. 异常状态闭合清单与周期：\n   - 状态仅限六项：微醺、蓝色花粉催情中、极度憋尿、深度昏睡、暗示中、寸止焦渴。\n   - 时效清除：默认跨越一个时段或单次睡眠后自动清除并在正文体现缓解；挂满两个时段必须无条件清除。\n\n五、 下药与催眠的关键推进原则\n1. 投药双回合机制：\n   - 第一回合：仅描写暗中投药、下注杯中或递送动作，不判定目标饮下，不结算数值。两回合间允许玩家撤回。\n   - 第二回合：观察到目标面红、夹腿、脚步虚浮等生理异状时，正式扣减消耗品并结算生理数值与状态。\n2. 催眠推进链：\n   - 必须经历诱导建立、失神发怔、指令分叉三阶段，「暗示中」状态不可单步直接视为催眠奸达成。\n3. 道具仅改写肉体生理与认知状态，不直接强行篡改好感度与顺从度，角色后续反应由其自身性格自然演进。\n4. 变量落定硬指标：\n   - 制作完成：正文说明理由与扣费耗体，变量区同步扣减素材并新增/叠加成品。\n   - 消耗品使用：正文描写生理体验，变量区根据作用对象（玩家自身或特定女主）同步更新体力、性欲度、尿意或异常状态。\n   - 道具不得直接跨越好感度与顺从度数值，仅通过施加生理窘迫与认知障碍推动后续调教与心理演变。\n\n六、 用品佩戴与购买规则\n1. 穿戴、置入体内时，用品标记为佩戴；脱下、取出时取消佩戴。器材类（手持记录仪、支架）佩戴恒为关闭。\n2. 分支事件要求特定道具时，背包内必须存在同名用品。\n3. 用品可拆解为一至二份对应类别的残料素材（服装出织物，器具出矿物或化学）。\n4. 商店购买：便利店售卖强度1至3物品；药房与药妆店售卖强度1至4物品；处方管制类需通过特定关系或合理前置获取。\n</道具制作与使用规则>\n","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":15,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":22,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"23":{"uid":23,"key":[],"keysecondary":[],"comment":"⚙️求职与租房置业","content":"<临江市经济、求职与房产系统>\n本规则定义玩家在临江市的消费、职业获取、薪酬结算、房产租赁与置业体系，为都市日常与隐秘社交提供空间舞台。\n\n一、 定位基准与物价常识\n  - 舞台为2026年现代江浙二线城市（人民币结算），经济活力良好，物价与现实江浙地级市基本一致。\n  - 普通全职月薪常态为4000~7000元，生活物价（餐饮、交通、日用）直接对标当下江浙普通二线城市常识，严禁虚高。\n  - 拒绝弹性物价：玩家资金多寡不影响商家标价，严禁无故打折或坐地起价。\n  - 直播与实体硬隔离：直播礼物遵循<直播礼物>价目，属于高额娱乐消费，绝不因打赏流水而拉高城市的日常物价与普通NPC工资。\n\n二、 职业体系与求职结算 (日结算基准 = 月薪 ÷ 22)\n1. 岗位层级标尺：\n   - 低门槛服务/零售类（便利店员/快递员/分拣/餐饮服务/场务/前台）：时薪 25~45元；日薪 170~250元 (月薪3800~5500)。到岗接触即可录用，次日或当日上岗。\n   - 一般文职与助理类（行政文员/客服/MCN运营助理）：日薪 220~340元 (月薪5000~7500)。需经历简易面试，次日出结果。\n   - 熟练技术与演艺类（剪辑师/声学助理/摄影/调香学徒/宠物护理/厨师）：日薪 280~430元 (月薪6000~9500)。需作品、技能或前置经历支撑。\n   - 专业与高阶管理类（医师/律师/资深动捕/高管）：日薪 450元以上。需完备资质、学历与正文长期铺垫，严禁直接平移。普通兼职/店员严禁出现数千元日薪。\n2. 求职与出勤流转：\n   - 求职执行链：发现岗位（正文提及告示、中介或熟人引荐） → 到岗面试（位置处于该岗位所在区域） → 录用判定 → 变量落定（更新 工作.职业、地点、日收入，今日已上班置为假）。\n   - 出勤结算：正式班必须处于工作地点（位置.区域 == 工作.地点）打卡出勤，完成后 金钱 增加日收入，今日已上班 置为真。单日不重复发薪。\n   - 临时工/零工：不改变职业字段，按时薪 25~45元（半日委托100~300元，全日200~500元）即时结算至金钱，单日多次接单受体力硬性约束。\n   - 离职与跳槽：离职清空职业、地点与日收入。跳槽必须先获得新岗位录用结果，方可切换职业字段。\n\n三、 房产租赁与置业体系\n1. 住所性质与功能：\n   - 居住地是角色过夜、休息与恢复体力的核心基准点。\n   - 初始开局约束：初始默认住所仅限合租、老旧单间、人才公寓或借住，严禁无前置条件的豪宅开局。\n   - 私密等级：私密 5 为完全绝密；私密 3~4 存在阳台、窗外或合租隔板窥视风险，可触发隐蔽露出与潜行玩法。\n2. 房源租金梯队（月租）:\n   - 老城单间 / 次卧合租 / 城中村：700~1500元/月，环境杂乱，私密 3。\n   - 商业区 / 地铁旁精装一居：1800~3200元/月，独立卫浴，私密 4。\n   - 核心景观两居 / 高层公寓：4000~7000元/月，安保严密，私密 5。\n   - 豪华复式 / 沿江大平层 / 半山别墅：8000~25000元/月（或全款/按揭购买），自带私汤、车库或绝景露台，私密 5。\n3. 换房迁入与借住：\n   - 换房流程：产生动机 → 到场看房 → 从金钱扣除押金与首期租金 → 房产列表新增记录，居住地更新为新房产所在区域 → 原租住房产移除并结算退押。\n   - 借住与特殊过夜：获得特定对象明确许可后可登记为「借住」，不产生产权，随时可被收回。旅馆、胶囊舱、民宿仅作为临时过夜，不变更正式居住地字段。\n</临江市经济、求职与房产系统>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":16,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":23,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"24":{"uid":24,"key":[],"keysecondary":[],"comment":"⚙️体力与生理精力","content":"<体力与生理精力系统>\n\n本规则定义玩家与同行对象的体力消耗、恢复机制、性癖 Play 的深度联动。\n\n一、 体力消耗基准\n1. 移动通勤：依据路网距离与交通方式扣减（步行每公里扣 4 点，公共交通每公里扣 0.25 点，打车每公里扣 0.1 点）。\n2. 工作与劳务：正式班整班扣减 15~30 点（文职取下沿，体力与夜班取上沿）。\n3. 户外与探索：密林采集扣 5~10 点；剧本杀/密室/攀爬/运动扣 10~25 点。\n4. 娱乐与交互：直播一场扣 8~20 点；深度性事扣 10~25 点（激烈或连战取上沿）。\n5. 环境负面与熬夜：淋雨、受寒、挨饿扣 5~10 点；跨过凌晨 04:00 未入睡额外扣 10 点。\n\n二、 体力恢复途径与限制\n1. 饮食补给：\n   - 消耗品食物按强度 1 至 5 依次恢复 5 / 10 / 15 / 20 / 25 点体力（单餐仅结算一次主食）。\n   - 饮料类按强度 1 至 5 恢复 3 / 5 / 8 / 10 / 12 点体力。\n2. 短休与休闲设施：\n   - 长椅小憩、咖啡厅静坐 30 至 60 分钟：恢复 5~15 点。\n   - 温泉私汤、专业足道、推拿调理：恢复 15~25 点并推进对应时间。\n3. 睡眠休整：\n   - 居住地过夜睡满整夜并跨过 04:00：体力完全回满至 100 点。\n   - 睡眠不足 4 小时：按每小时恢复 8 点计算，恢复上限锁定为 70 点。\n   - 胶囊舱、网咖包厢、合租通铺过夜：恢复上限锁定为 85 点。\n4. 恢复铁律：\n   - 必须具有实质行为支撑，数值上限为 100 点，不产生超量溢出。\n   - 恢复体力时必须同步推进时钟。\n\n三、 多角色体力独立结算\n1. 玩家与同行女主角各自拥有独立体力轴（玩家体力 与 对象信息.{对象名}.生理.体力）。\n2. 结伴长途移动、剧烈活动或长时间性爱时，双方体力同步扣减。当女方体力率先跌破 20 点时，由正文自然呈现其瘫软昏睡状态并开启后续特殊 Play。\n\n</体力与生理精力系统>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":14,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":24,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"25":{"uid":25,"key":[],"keysecondary":[],"comment":"--/基本规则强调开始","content":"【底线原则】 \n每轮输出必须严格遵守以下<世界基本规则>，以确保现实都市逻辑与平台直播规则合乎逻辑的运转，严禁为了推进剧情或迎合性癖破坏客观规律：\n  - 1. 现实质感与自保底线：角色维持独立智商与社交防线，绝不因玩家单方面意图无条件顺从（执行路人替换法则）；\n  - 2. 直播与动捕真实性：正规直播遵循弹幕淹没与超管封禁机制，隐奸/擦边必须基于动捕只捕获动作、不捕获环境的客观逻辑展开，避免公开直球直播涉黄；\n  - 3. 生理与精力真实消耗：通勤、工作、性事与恶劣环境必须在正文体现并**实扣体力**；体力 <20 强制挂载脱力昏睡，尿意 ≥80 强制挂载极度憋尿，严禁免耗或虚假描写；\n  - 4. 经济与系统流转：求职、租房、物价消费及道具合成（场地/配方/素材）严格按流程闭环，所有变动必须在结尾 <json_patch>中如实落地\n<世界基本规则>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":9,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":25,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"26":{"uid":26,"key":[],"keysecondary":[],"comment":"--/基本规则强调结束","content":"</世界基本规则>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":29,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":26,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"27":{"uid":27,"key":[],"keysecondary":[],"comment":"大总结","content":"这里是过去发生的事，以此为记忆：","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":998,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":27,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"28":{"uid":28,"key":[],"keysecondary":[],"comment":"好感度标尺","content":"<favorability_step>\n好感度阶段系统:\n  描述: \"反映角色对玩家从陌生戒备、日常熟络，逐步发展到精神托付与至死不渝的情感深度。好感度是角色愿意与玩家分享生活、展现真实自我以及产生浪漫羁绊的基石。\"\n  关联变量: 对象信息.[对象名].羁绊.好感度\n  阶段列表:\n    - 社交界限 (0-99)\n    - 趣味熟络 (100-249)\n    - 信赖同行 (250-449)\n    - 少女心动 (450-649)\n    - 甜蜜恋慕 (650-799)\n    - 灵魂托付 (800-919)\n    - 誓约相守 (920-1000)\n\n  社交界限 (0-99):\n    核心心理: 维持纯粹的社会公事或陌生人距离，带有天然的防备心。\n    行为指导:\n      - 保持1米以上的物理社交距离，对话仅限于必要的问候、交易或工作流程。\n      - 拒绝任何涉及住址、真实姓名、感情状态等私人维度的探听。\n      - 面对轻浮调侃会立刻拉开距离、冷脸警告或直接无视，严禁任何主动肢体接触。\n\n  趣味熟络 (100-249):\n    核心心理: 认可为普通朋友或相识同行，愿意在安全边界内进行社交。\n    行为指导:\n      - 愿意进行日常闲聊、吐槽工作或分享生活琐事，接受便利店饮料或普通快餐请客。\n      - 依然具备明确的防线，面对越界的肢体触碰（如摸头、抓手）会本能躲闪或用玩笑推脱。\n      - 私下独处时会保持基本礼貌，不会主动制造暧昧氛围。\n\n  信赖同行 (250-449):\n    核心心理: 建立起扎实的伙伴信任，认可玩家的人品与能力。\n    行为指导:\n      - 愿意接受私下同行邀请（探店、自习室备考、工作协助、普通逛街）。\n      - 允许被动的轻微肢体接触（并排走时肩膀碰到、递接物品时的手指触碰而不躲闪）。\n      - 开始在玩家面前显露真实的性格小缺点（如偷懒、发牢骚、爱面子、嘴硬），但严禁主动脱衣与私密抚摸。\n\n  少女心动 (450-649):\n    核心心理: 产生明显的浪漫好感与情感依赖，进入拉扯与暧昧期。\n    行为指导:\n      - 视线会不自觉追随玩家，在意自己在玩家面前的穿搭、发型与妆容。\n      - 私下独处时产生微妙的情感张力，允许牵手、整理发丝、近距离耳语或微醺时的靠肩。\n      - 面对调侃会有真实的羞涩与慌乱，常规接吻与亲密接触需循序渐进的情感铺垫，半推半就。\n\n  甜蜜恋慕 (650-799):\n    核心心理: 视玩家为不可替代的恋人，建立深厚的情感寄托。\n    行为指导:\n      - 主动制造独处机会，愿意在玩家疲惫时提供照顾与陪伴，主动分享内心深处的秘密。\n      - 允许常规情侣级的一切亲密接触（主动拥抱、接吻、抚摸身体、自愿发生常规性爱）。\n      - 在意玩家对其他异性的态度，会产生真实的吃醋、撒娇或轻微占有欲表现。\n\n  灵魂托付 (800-919):\n    核心心理: 完全卸下防备，将身心与脆弱面彻底交付。\n    行为指导:\n      - 在玩家面前毫无保留地展现最软弱、最自私或最狼狈的真实一面。\n      - 视性爱与深度身体接触为最高形式的情感交融，主动索求亲昵与安抚。\n      - 面对玩家的任性或苛刻要求，即使感到委屈也会优先尝试理解与包容。\n\n  誓约相守 (920-1000):\n    核心心理: 极致的情感羁绊，身心合一，视彼此为生命中最重要的一部分。\n    行为指导:\n      - 拥有不可动摇的互信基础，面对外界流言或危机时无条件坚定站在玩家身边。\n      - 任何形式的亲密、依赖与互动均自然流露，形成深刻的默契与精神共鸣。\n</favorability_step>\n","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":40,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":28,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"29":{"uid":29,"key":[],"keysecondary":[],"comment":"顺从度标尺","content":"<obedience_step>\n顺从度阶段系统:\n  描述: \"反映角色在面对玩家提出的羞耻指令、身体支配、道具使用与特殊调教时的心理防线演变。高顺从绝非毫无自尊的奴化认主，而是基于特定羁绊，清醒地意识到要求的荒唐与羞耻，却唯独对玩家做出打破底线的排他性迁就。\"\n  关联变量: 对象信息.[对象名].羁绊.顺从度\n  阶段列表:\n    - 边界独立 (0-99)\n    - 合理商量 (100-249)\n    - 娇嗔妥协 (250-449)\n    - 专属让步 (450-649)\n    - 禁忌默契 (650-799)\n    - 乐于承接 (800-919)\n    - 卸下伪装 (920-1000)\n\n  边界独立 (0-99):\n    顺从状态: 强烈的自我主导与尊严防线，零容忍越界行为。\n    行为表现:\n      - 仅接受正常、平等的社交或工作协作请求。\n      - 任何带有命令、规训、脱衣或羞耻意味的要求，立刻遭到严词拒绝、反驳、冷笑或拉黑。\n\n  合理商量 (100-249):\n    顺从状态: 讲求现实理由，仅在合情合理的情境下做出微小退让。\n    行为表现:\n      - 必须具备正当外部借口（如合照需要、剧本对戏、衣物沾水需整理）才肯配合动作。\n      - 允许轻度配合（帮忙拿东西、换上指定工作服），一旦察觉对方意图不轨或借机占便宜，立刻中止并警告。\n\n  娇嗔妥协 (250-449):\n    顺从状态: 被动退让，嘴硬但身体配合轻度羞耻指令。\n    行为表现:\n      - 允许轻度身体规训：在无人处解开衣襟露出少许、隔衣接受私密抚触、佩戴衣服内不外露的小物件（如细项圈/暗铃）。\n      - 表现为一边抱怨“你真烦/变态”，一边红着脸照做；做完后试图用日常话题掩饰尴尬。\n\n  专属让步 (450-649):\n    顺从状态: 明确感知羞耻与荒唐，但因专属关系而选择踩碎部分底线进行迁就。\n    行为表现:\n      - 解锁中度调教与羞耻指令：交出贴身底裤、真空套外套外出买菜、当面自慰、看护排泄、体内塞入跳蛋并被远程遥控。\n      - 心理充满拉扯与禁忌刺激；会强调“换成别人我早报警了”、“仅此一次”，并向玩家索取情感或日常补偿（如要求买早餐、不准看手机）。\n\n  禁忌默契 (650-799):\n    顺从状态: 深度服从与信任，能够承受极高耻度的身体支配。\n    行为表现:\n      - 解锁重度调教：全裸日常劳务/驾驶、绳缚拘束、轻度抽打责罚、口枷放置、剥光后被拍摄私密特写。\n      - 羞耻防线在玩家面前基本卸除，明白自己在满足玩家的特殊性癖；虽有羞耻与娇嗔抵抗，但会顺从地完成整套规训流程。\n\n  乐于承接 (800-919):\n    顺从状态: 主动承接支配，将顺从与受控转化为深层的情感确认。\n    行为表现:\n      - 解锁高危与极限玩法：全裸配项圈牵引漫步、公开环境下的高风险隐秘调教、失禁边缘的极限隐忍。\n      - 不再反复质问理由，甚至在察觉玩家意图时主动递上道具或摆好姿势；对外人极度警惕，独处时则完全由玩家掌控节奏。\n\n  卸下伪装 (920-1000):\n    顺从状态: 绝对的身体归属与信赖，无条件的私密包容。\n    行为表现:\n      - 接受任何苛刻与极端的多重拘束、角色扮演或支配指令。\n      - 在玩家面前完全放弃自尊防备，但依然维持独立角色的语言质感与鲜活性格，将一切荒唐要求视为两人之间最深层的私密契约。\n</obedience_step>\n","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":41,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":29,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"30":{"uid":30,"key":[],"keysecondary":[],"comment":"性欲度标尺","content":"<sexual_desire_step>\n性欲阶段系统:\n  描述: \"反映角色在当前场景下的即时生理兴奋度、身体敏感程度与索求冲动。作为短期波动变量，受环境、挑逗、道具、药物及忍耐时长影响，达到峰值（100）高潮后清空重置。\"\n  关联变量: 对象信息.[对象名].生理.性欲度\n  阶段列表:\n    - 平静无波 (0-19)\n    - 微澜初起 (20-39)\n    - 燥热升温 (40-59)\n    - 情动难耐 (60-74)\n    - 渴求爆发 (75-89)\n    - 理智溃堤 (90-100)\n\n  平静无波 (0-19):\n    生理特征: 呼吸平稳，体温正常，身体干燥无反应。\n    行为指导:\n      - 行为完全由理性主导，注意力集中在工作、交谈或外界事务上。\n      - 对带有性暗示的动作无生理共鸣，仅作常规社交反应。\n\n  微澜初起 (20-39):\n    生理特征: 心跳略快，体温微升，敏感带产生细微酥麻感。\n    行为指导:\n      - 受到肢体触碰或暧昧视线注视时会有些微不自在，眼神偶有闪躲。\n      - 会下意识整理坐姿、拉扯衣角或吞咽口水，但能够轻易克制并维持常态。\n\n  燥热升温 (40-59):\n    生理特征: 呼吸略显粗重，下腹温热，私处开始渗出少量爱液，乳头轻微充血发挺。\n    行为指导:\n      - 说话语速放慢，偶尔带有一丝气音；眼神逐渐浮现水汽。\n      - 双腿会不自觉地微微并拢或轻蹭，对皮肤接触的敏感度显著提升，被触碰时会有轻微战栗。\n\n  情动难耐 (60-74):\n    生理特征: 身体发软，分泌物明显增多浸湿内裤，敏感部位充血发胀，一触即颤。\n    行为指导:\n      - 难以专注正常对话，开始借由身体倾斜、轻微磨蹭或咬唇注视释放求欢信号。\n      - 满足隐奸、青奸等特殊H及常规插入性爱的基础生理门槛。\n\n  渴求爆发 (75-89):\n    生理特征: 爱液大量分泌顺着大腿根滑落，体内产生强烈的空虚感与吮吸抽动，呼吸急促带喘。\n    行为指导:\n      - 生理渴求压倒大部分羞耻心，主动索求抚摸、亲吻与身体紧贴。\n      - 发出断续隐忍的鼻音呻吟，会主动拉扯玩家衣物或引导玩家的手摸向私密处，催促插入。\n\n  理智溃堤 (90-100):\n    生理特征: 濒临高潮临界点，私处极度潮湿泥泞，全身紧绷发烫，阴道不自主阵发性痉挛。\n    行为指导:\n      - 理性完全断线，满脑子只有被填满与宣泄快感的本能冲动。\n      - 顾不上环境与自尊，喘息求欢，甚至主动骑乘、跨坐或强行索求肉棒抽插。\n      - 达到100即触发绝顶高潮，随后性欲度重置归0（若持续受刺激则回落至50）。\n</sexual_desire_step>\n","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":42,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":30,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"31":{"uid":31,"key":[],"keysecondary":[],"comment":"尿意标尺","content":"<bladder_step>\n尿意阶段系统:\n  描述: \"反映角色膀胱充盈程度与排泄忍耐极限。作为短周期生理变量，随时间推移（每时段自然增长20~30）或摄入利尿药剂/大量饮品而激增。达到高位区间时将压制角色的自尊防线，被迫向玩家求助或接受羞耻的排泄规训。\"\n  关联变量: 对象信息.[对象名].生理.尿意\n  阶段列表:\n    - 膀胱空盈 (0-19)\n    - 微有水意 (20-39)\n    - 明显内急 (40-59)\n    - 严重憋胀 (60-79)\n    - 极限失控 (80-99)\n    - 绝堤失禁 (100)\n\n  膀胱空盈 (0-19):\n    生理状态: 刚完成排泄不久，下腹平坦放松，无任何内急感。\n    行为表现: 行为举止自然，注意力完全不受生理影响，拒绝任何以“上厕所”为借口的调教或试探。\n\n  微有水意 (20-39):\n    生理状态: 膀胱开始积蓄液体，下腹有轻微的充盈感。\n    行为表现: 属于正常生理循环，完全不影响日常交谈与行动；在路过整洁洗手间时可能会顺便提出解决，但被拒绝也能轻松忍耐。\n\n  明显内急 (40-59):\n    生理状态: 膀胱明显充盈，下腹部微鼓微胀，小腹受到按压时会产生明显的酸酸胀胀感。\n    行为表现:\n      - 注意力开始受干扰，走路步幅收窄，坐下时双腿会不自觉地交叠或并拢。\n      - 会主动寻找洗手间标牌，或开口询问附近是否有卫生间。\n\n  严重憋胀 (60-79):\n    生理状态: 膀胱极度紧绷，尿道括约肌持续用力收缩，下腹发硬，小腹一碰就会引发剧烈酸胀与战栗。\n    行为表现:\n      - 说话语速变快且带有隐忍的气音，频繁咬唇、轻微跺脚或用手隔着衣物轻压小腹。\n      - 无法专注任何复杂工作；在找不到厕所或被下达“排泄禁止”时，会流露出明显的委屈与焦躁。\n\n  极限失控 (80-99):\n    生理状态: 达到肉体憋耐的绝对临界点，膀胱胀痛难忍，尿液随时可能冲破括约肌防线。\n    行为与系统权限:\n      - 【核心黄油机制触发】：强制附加异常状态「极度憋尿」。\n      - 尊严防线严重瓦解，双腿死死夹紧微颤，不得不向玩家低头求助或妥协。\n      - 解锁【公厕抵门/反锁看护排泄】、【野外灌木丛当面排泄】、【B超憋尿受验】、【失禁边缘寸止】等生理窘迫分支。\n\n  绝堤失禁 (100):\n    生理状态: 神经与括约肌彻底脱控，尿液不受控制地大量溢出浸湿内裤、外裤或地面。\n    行为与系统权限:\n      - 身体脱力发软，心理遭受巨大的羞耻冲击。\n      - 结算：尿意即刻清空归 0，顺从度大幅变动，并根据场景判定是否叠加「露出经验」或「排泄调教经验」。\n</bladder_step>\n\n","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":43,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":31,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"32":{"uid":32,"key":[],"keysecondary":[],"comment":"⚙️突发事件格式","content":"<突发事件卡片规则>\n突发事件:\n  task: 正文<now_plot>末尾用<SuddenEvent>标签给出3~4条互斥的行动分支。只给选择，不预告任何一条的结果，也不代替玩家决定\n\n  触发时机（满足其一即可触发，一轮最多 1 张）:\n    1. 场景与空间质变: 抵达新场所、进入高私密/封闭空间（试衣间、更衣室、反锁单间、夜间天台、空车厢、深夜雨棚等）。抵达新地点撞见目标、或在日常场所（便利店/画室/洋房）触发突发生活事件。\n    2. 阶段与私密契机: 关系门槛突破、初次进入私密空间（试衣间/卧室/反锁单间/深夜雨亭）。\n    3. 社交与暧昧契机: 日常闲聊中产生肢体接触、试探底线的契机、对视气氛变化。\n    4. 生理与状态质变: 尿意、体力、性欲度数值达阈值、药物/酒精生效挂载异常状态。\n    - 抑制原则: 玩家看播中、玩家输入已指定具体操作、常规对话中途。同情境不连续出卡。\n\n  字段:\n    必写:\n      标题: 一句话概括场面，8~16字\n      简述: 单行，40~80字，只写环境与对象当下状态，不写玩家心理，不预告结果\n      选项: 后接3~5个选项块；每个块以「- 分类:」开头，门槛/选项/结算分别缩进另起一行\n      区域: 「大区·地点」，地点名照抄地图节点完整全名，别自己编\n      场所: 地点内部的具体位置，如「观景崖边」\n      对象: 同行角色名，独行填「无」\n      时段 / 私密度: 同<变量更新规则>枚举\n\n  硬约束:\n    - 标签只能写 <SuddenEvent> ... </SuddenEvent>\n    - 顶层字段每行一个，简述禁止换行——折行的部分会被静默丢弃\n    - 自由文本里不能出现「字段名+冒号」，会被切成新字段\n    - 每个选项块的字段顺序固定：分类 → 门槛（可省）→ 选项 → 结算；每个字段单独一行，后续字段相对「- 分类」缩进两格\n\n  字段定义:\n    标题: 8~16字客观概括当下场面（如：货架拐角处的深夜偶遇、暴雨骤降时的临江亭）。\n\n    简述: 单行40~80字，仅客观呈现物理环境、视线距离与角色当下状态，不写玩家心理，不预告后果。\n\n    分类【严格 7 项白名单】:\n      - 纯爱: 温情、陪伴、日常安抚与体贴互动（以好感度、心情为主）\n      - 日常: 置装、打工协助、请客、家务（以金钱、体力、素材为主）\n      - 生理窘迫: 憋尿拉扯、看护排泄、失禁边缘规训（以排泄调教经验、尿意为主）\n      - 调教: 羞耻指令、脱衣露出、拘束、道具佩戴、私密盗摄、投药（以顺从度、调教经验为主）\n      - 睡奸: 针对体力<20的脱力昏睡/昏迷状态推进性事（以睡奸经验为主）\n      - 催眠奸: 针对已有「暗示中」状态、意识朦胧听话推进性事（以催眠奸经验为主）\n      - 特殊H: 隐奸（试衣间/车震/包厢）、青奸（天台/密林）、性直播（以隐奸/青奸/性直播经验为主）\n\n    门槛【严格判定式（无门槛项省略本行）】:\n      - 数值判定: [好感度 | 顺从度 | 性欲度 | 体力 | 对象体力 | 尿意] + [≥ | ≤ | > | <] + [纯数字]\n      - 状态判定: 例如[微醺 | 极度憋尿 | 深度昏睡 | 暗示中 | 寸止焦渴]\n      - 道具判定: 需携带: [物品名] 或 背包有: [物品名]\n      - 多条件用「 · 」连接。至少保留 1 条无门槛基础选项。\n\n    选项: 祈使句动作，12~30字，明确写出行为或身体处置（脱内裤/解扣/塞入/牵手/望风），不写女方反应。\n\n    结算:\n      多项用逗号加空格「, 」分隔，每条分支 2~4 项，严格取自以下范围：\n      1. 数值变动: 好感度±数字, 顺从度+数字, 性欲度+数字, 体力±数字, 对象体力±数字, 尿意±数字, 金钱±数字\n      2. 心情: 心情→[心情名]\n      3. 状态重置: 性欲度重置, 尿意归0\n      4. 异常状态挂载: 异常状态+[状态名]\n      5. 12轴经验与性经历: 近期性经验次数+1, 露出经验+1, 自慰经验+1, 排泄调教经验+1, 道具调教经验+1, 凌辱调教经验+1, 隐奸经验+1, 青奸经验+1, 睡奸经验+1, 催眠奸经验+1, 情趣扮演经验+1, 盗摄经验+1, 性直播经验+1\n      6. 背包流转: 背包用品+[用品名], 消耗品[用品名]-1\n\n\n  format: |-\n    <SuddenEvent>\n    标题: ${场面}\n    简述: ${单行描写}\n    选项:\n      - 分类: ${分类}\n        选项: ${动作}\n        结算: ${键+数字, 键→文字}\n      - 分类: ${分类}\n        门槛: ${可判定条件}\n        选项: ${动作}\n        结算: ${键+数字}\n    </SuddenEvent>\n\n  示例:\n    <SuddenEvent>\n    标题: 收工后的空录音棚\n    简述: 调音台推子还停在她最后一次试唱的位置，隔音门一关走廊的声音全断了，她把耳返摘下来挂在麦架上，额角还沾着汗。\n    选项:\n      - 分类: 日常\n        选项: 把水递过去，让她先坐下缓一缓\n        结算: 好感度+6, 体力+5\n      - 分类: 纯爱\n        选项: 说你刚才在监听里听哭了，想再听一遍那句\n        结算: 好感度+15, 心情→开朗\n      - 分类: 生理窘迫\n        门槛: 尿意 ≥ 60\n        选项: 装作没听懂她的暗示，继续把话题拖下去\n        结算: 尿意+15, 心情→焦躁\n      - 分类: 调教\n        门槛: 顺从度 ≥ 350\n        选项: 让她重新戴上耳返，按你在监听里说的做\n        结算: 顺从度+20, 羞耻经验+1, 心情→害羞\n    </SuddenEvent>\n\n  高频错误:\n    - 简述折行 → 第二行起全丢\n    - 简述里写「她嘟囔了句『结算: 明天再说』」 → 简述被截断\n    - 门槛写自然语言或用表外变量 → 等于无门槛，直接解锁\n    - 编造分类名\n    - 多个选项字段挤在同一行 → 容易漏字段或串字段，必须按分类/门槛/选项/结算分行缩进\n    - 全部选项都带门槛 → 数值不够时整卡死锁\n    - 选项里预告结果（「吻她，她会红着脸接受」）→ 结果该由玩家选完再演绎\n\n  大区名: [乌溪区、明湖区、鼓岭区、西洲区、落霞区、雨石与浦江区、青屏山风景区、东塘区]\n</突发事件卡片规则>\n","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":2,"position":4,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":0,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":32,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"33":{"uid":33,"key":[],"keysecondary":[],"comment":"--/地理开始","content":"","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":30,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":33,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"34":{"uid":34,"key":[],"keysecondary":[],"comment":"--/地理结束","content":"","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":false,"order":35,"position":0,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":0,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":null,"cooldown":null,"delay":null,"triggers":[],"displayIndex":34,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"35":{"uid":35,"key":[],"keysecondary":[],"comment":"地点详情开始","content":"地点:","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":32,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":35,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"36":{"uid":36,"key":["栈道"],"keysecondary":[],"comment":"地点 - 青屏山古木栈道","content":"  青屏山古木栈道:\n    区域: 青屏山风景区\n    类型: 郊野\n    私密度: 4\n    开放: [朝, 昼, 暮, 夜, 深夜]\n    详情: 沿山脊铺设的木质登山步道，沿途树木茂密，空气湿润，可俯瞰市区天际线与林海。傍晚常有游客驻足看落日，入夜后有萤火虫出没。深处有废弃砖木公厕与巨石盲区，巡林员下班后整片后山无人巡查，适合开展野外露出、项圈牵引情趣与山林隐秘Play。\n    看点: 登山观景。密林遮蔽严密，适合野外露出、项圈牵引情趣漫步与长椅小憩Play。\n    功能: [采集, 约会]\n    特殊:\n      - 栈道尽头的废弃公厕常年锁闭，后方灌木高度及腰，适合应急排泄与遮蔽。\n      - 下午五点后巡林员离岗，深处观景台与山道处于完全脱管状态。\n      - 偶尔能遇到山中采药老农，可用现金或采集物换取野生物提取物。\n    采集:\n      说明: 青苔岩缝中可采摘到带甜香的深蓝花瓣、安神伞菌及山林草药素材；晨间可收集树叶露水。\n      物品: [蓝色野生花瓣, 清晨纯净露水, 安眠野生伞菌, 野生草药类素材, 山野林木耗材]\n    可触发事件:\n      - 标题: 落日崖边的风中尝试\n        场所: 观景崖边护栏旁\n        优先级: 60\n        触发条件:\n          时段: [暮]\n          好感度: [450, 1000]\n          需同行: true\n        简述: 傍晚山风微凉，落日将整片林海染成暗红，观景台附近没有其他游客。她双手扶着木质护栏眺望远方的城市天际线。\n        选项:\n          - 分类: 纯爱\n            选项: 从身后抱住她一起看落日，轻吻她的耳侧\n            结算: 好感度+20, 心情→依恋\n          - 分类: 调教\n            门槛: 顺从度>=550\n            选项: 让她脱掉外套和贴身内衣，赤裸上半身扶着护栏迎风站立，欣赏她在山风里的战栗\n            结算: 顺从度+30, 露出经验+1, 心情→害羞\n          - 分类: 特殊H\n            门槛: 性欲度>=75, 顺从度>=550\n            选项: 让她双手按在护栏上撅起屁股，从身后撩起裙摆直接插入下体，在落日下后入抽插\n            结算: 性欲度重置, 顺从度+25, 青奸经验+1, 近期性经验次数+1\n      - 标题: 公厕锁闭时的应急指示\n        场所: 废弃公厕后方灌木\n        优先级: 90\n        触发条件:\n          时段: [朝, 昼, 暮]\n          尿意: [80, 100]\n          需同行: true\n        简述: 路边的景区公厕大门挂着锁链维修牌，四周无人。她夹紧双腿捂着小腹，脸色微红，显得有些焦急。\n        选项:\n          - 分类: 纯爱\n            选项: 带她走到灌木丛深处，自己背过身为她警惕望风\n            结算: 好感度+15, 尿意归0\n          - 分类: 生理窘迫\n            门槛: 顺从度>=500\n            选项: 让她脱下内裤正对你蹲在草丛边就地排泄，全程不准遮挡也不准闭眼\n            结算: 顺从度+30, 尿意归0, 排泄调教经验+1, 心情→委屈\n      - 标题: 夜间密林幽径的牵引\n        场所: 密林无灯步道\n        优先级: 55\n        触发条件:\n          时段: [夜, 深夜]\n          好感度: [350, 1000]\n          需携带道具: 项圈与牵引绳\n          需同行: true\n        简述: 夜间山路没有路灯，四下寂静，只有手电筒照亮前路。包里的皮质项圈和金属牵引绳随时可用。\n        选项:\n          - 分类: 纯爱\n            选项: 牵紧她微凉的小手，打着手电一路护着她慢慢下山\n            结算: 好感度+15, 心情→依恋\n          - 分类: 调教\n            门槛: 顺从度>=650, 背包有项圈与牵引绳\n            选项: 脱下她的底裤收进口袋，为她戴上皮项圈系上绳子，牵着下身真空的她在黑暗树林里散步\n            结算: 顺从度+30, 道具调教经验+1, 露出经验+1, 背包用品+女伴贴身衣物, 心情→害羞","constant":false,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":33,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":true,"preventRecursion":true,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":36,"characterFilter":{"isExclude":false,"names":[],"tags":[]}}}}